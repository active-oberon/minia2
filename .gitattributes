*.bin filter=lfs diff=lfs merge=lfs -text

# A2 / Active Oberon sources. Without this they are detected as Modula-2,
# and some of them as AMPL.
*.Mod linguist-language=Oberon
*.mod linguist-language=Oberon

# .Tool files are A2 command lists, not shell scripts.
*.Tool linguist-detectable=false

# tree-sitter generates these from grammar.js; committed so an editor can build the
# grammar without the CLI, but they are not source.
editors/tree-sitter/src/parser.c linguist-generated=true
editors/tree-sitter/src/grammar.json linguist-generated=true
editors/tree-sitter/src/node-types.json linguist-generated=true
editors/tree-sitter/src/tree_sitter/** linguist-vendored=true

data/OBEMBR.BIN -filter -diff -merge
