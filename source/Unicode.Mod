MODULE Unicode;
(**
	AUTHOR "Andrii Puhachenko";
	PURPOSE "The Unicode character database as a compiled table: categories and simple case mapping";
	LIMITATIONS
		"- simple case mapping only: the one-to-many mappings of SpecialCasing.txt (sharp s to SS)
		   and every locale rule are not here;
		 - no normalisation, no decomposition, no bidirectional class -- categories and case is
		   what the string layer and the pattern matcher need, and adding the rest is adding
		   columns to the same generator."
*)
(*	GENERATED by tests/gen-unicode.py -- do not edit.
	Source: data/UnicodeData.txt, sha1 b63b36e92b07919e602e731dd98cbfbefd3b56c4 -- Unicode 5.0.
	A newer table is a newer file in data/ and this script run again; nothing here is hand-made.
	2642 runs over 1114112 code points, 151 distinct (category, upper delta, lower delta) values.
	The module UnicodeProperties reads that same file at run time through Texts and Codecs,
	which is why it cannot travel in a headless SDK and this table can. *)

CONST
	(** general categories, the two-letter names of the standard *)
	Cn* = 0;	Lu* = 1;	Ll* = 2;	Lt* = 3;	Lm* = 4;	Lo* = 5;
	Mn* = 6;	Mc* = 7;	Me* = 8;	Nd* = 9;	Nl* = 10;	No* = 11;
	Pc* = 12;	Pd* = 13;	Ps* = 14;	Pe* = 15;	Pi* = 16;	Pf* = 17;
	Po* = 18;	Sm* = 19;	Sc* = 20;	Sk* = 21;	So* = 22;	Zs* = 23;
	Zl* = 24;	Zp* = 25;	Cc* = 26;	Cf* = 27;	Cs* = 28;	Co* = 29;

	MaxCode* = 10FFFFH;	(** the largest code point Unicode defines *)

	nofRuns = 2642;
	nofValues = 151;

VAR
	start: ARRAY nofRuns OF SIGNED32;	(* first code point of the run, ascending *)
	value: ARRAY nofRuns OF SIGNED32;	(* which of the values below the run carries *)
	category: ARRAY nofValues OF SIGNED32;
	upper, lower: ARRAY nofValues OF SIGNED32;
	nruns, nvalues: SIGNED32;

PROCEDURE Hex(CONST s: ARRAY OF CHAR; VAR i: SIZE; digits: SIGNED32): SIGNED32;
VAR v, k: SIGNED32; c: CHAR;
BEGIN
	v := 0;
	FOR k := 1 TO digits DO
		c := s[i]; INC(i);
		IF c <= "9" THEN v := v * 16 + (ORD(c) - ORD("0")) ELSE v := v * 16 + (ORD(c) - ORD("A") + 10) END
	END;
	RETURN v
END Hex;

(* six hex digits of first code point, two of the value index *)
PROCEDURE R(CONST s: ARRAY OF CHAR);
VAR i: SIZE;
BEGIN
	i := 0;
	WHILE s[i] # 0X DO
		start[nruns] := Hex(s, i, 6); value[nruns] := Hex(s, i, 2); INC(nruns)
	END
END R;

(* two hex digits of category, then upper and lower delta, each biased by 800000H *)
PROCEDURE V(CONST s: ARRAY OF CHAR);
VAR i: SIZE;
BEGIN
	i := 0;
	WHILE s[i] # 0X DO
		category[nvalues] := Hex(s, i, 2);
		upper[nvalues] := Hex(s, i, 6) - 800000H;
		lower[nvalues] := Hex(s, i, 6) - 800000H;
		INC(nvalues)
	END
END V;

PROCEDURE Which(cp: SIGNED32): SIGNED32;
VAR lo, hi, mid: SIGNED32;
BEGIN
	IF (cp < 0) OR (cp > MaxCode) THEN RETURN -1 END;
	lo := 0; hi := nruns - 1;
	WHILE lo < hi DO
		mid := (lo + hi + 1) DIV 2;
		IF start[mid] <= cp THEN lo := mid ELSE hi := mid - 1 END
	END;
	RETURN value[lo]
END Which;

(** The general category of a code point; Cn for one Unicode does not assign. *)
PROCEDURE Category*(cp: SIGNED32): SIGNED32;
VAR i: SIGNED32;
BEGIN
	i := Which(cp);
	IF i < 0 THEN RETURN Cn END;	(* outside the code space, not inside run zero *)
	RETURN category[i]
END Category;

(** The simple upper case of cp, or cp when it has none. *)
PROCEDURE ToUpper*(cp: SIGNED32): SIGNED32;
BEGIN
	IF (cp < 0) OR (cp > MaxCode) THEN RETURN cp END;
	RETURN cp + upper[Which(cp)]
END ToUpper;

(** The simple lower case of cp, or cp when it has none. *)
PROCEDURE ToLower*(cp: SIGNED32): SIGNED32;
BEGIN
	IF (cp < 0) OR (cp > MaxCode) THEN RETURN cp END;
	RETURN cp + lower[Which(cp)]
END ToLower;

PROCEDURE IsUpper*(cp: SIGNED32): BOOLEAN;
BEGIN
	RETURN Category(cp) = Lu
END IsUpper;

PROCEDURE IsLower*(cp: SIGNED32): BOOLEAN;
BEGIN
	RETURN Category(cp) = Ll
END IsLower;

(** A letter is any of Lu Ll Lt Lm Lo, which is what "letter" means in the standard. *)
PROCEDURE IsLetter*(cp: SIGNED32): BOOLEAN;
VAR c: SIGNED32;
BEGIN
	c := Category(cp);
	RETURN (c >= Lu) & (c <= Lo)
END IsLetter;

(** A decimal digit: Nd, not the other numbers -- Roman numerals are Nl and one half is No. *)
PROCEDURE IsDigit*(cp: SIGNED32): BOOLEAN;
BEGIN
	RETURN Category(cp) = Nd
END IsDigit;

PROCEDURE IsNumber*(cp: SIGNED32): BOOLEAN;
VAR c: SIGNED32;
BEGIN
	c := Category(cp);
	RETURN (c >= Nd) & (c <= No)
END IsNumber;

PROCEDURE IsLetterOrDigit*(cp: SIGNED32): BOOLEAN;
BEGIN
	RETURN IsLetter(cp) OR IsDigit(cp)
END IsLetterOrDigit;

(** Space is Zs Zl Zp plus the ASCII controls every language calls white space. *)
PROCEDURE IsSpace*(cp: SIGNED32): BOOLEAN;
VAR c: SIGNED32;
BEGIN
	IF (cp = 9) OR (cp = 10) OR (cp = 11) OR (cp = 12) OR (cp = 13) THEN RETURN TRUE END;
	c := Category(cp);
	RETURN (c >= Zs) & (c <= Zp)
END IsSpace;

PROCEDURE IsControl*(cp: SIGNED32): BOOLEAN;
BEGIN
	RETURN Category(cp) = Cc
END IsControl;

PROCEDURE IsPunctuation*(cp: SIGNED32): BOOLEAN;
VAR c: SIGNED32;
BEGIN
	c := Category(cp);
	RETURN (c >= Pc) & (c <= Po)
END IsPunctuation;

