# Tests for the ciphers and digests of std/crypto that had no known answers.
#
# options --mayTrap --prolog="Compiler.Compile TesterInput.txt" --command="System.Free Test;System.Load Test"
#
# The package is thirty modules and the registry calls it stable. SHA-1 and SHA-256 were checked
# against published values already; MD5, SHA-3, AES and Base64 were not checked against anything.
#
# For cryptography a round trip is worth nothing: a cipher that decrypts what it encrypted, and a
# digest that agrees with itself, can both be wrong in a way that makes them useless -- the whole
# purpose is to agree with everybody else's. So every case here is a known answer, from the
# standard that defines it: FIPS-197 for AES, RFC 1321 for MD5, the NIST values for SHA-3,
# RFC 4648 for Base64.
#
# Each case is positive: it must compile and run its module body without a failing ASSERT.

positive: MD5 of what RFC 1321 says

	MODULE Test;
	IMPORT CryptoMD5, CryptoUtils;
	VAR h: CryptoMD5.Hash; digest: ARRAY 32 OF CHAR; hex: ARRAY 64 OF CHAR; data: ARRAY 8 OF CHAR;
	BEGIN
		NEW(h); h.Initialize;
		data := ""; h.Update(data, 0, 0);
		h.GetHash(digest, 0);
		CryptoUtils.Bin2Hex(digest, 0, hex, 0, 16);
		ASSERT(hex = "D41D8CD98F00B204E9800998ECF8427E");

		NEW(h); h.Initialize;
		data := "abc"; h.Update(data, 0, 3);
		h.GetHash(digest, 0);
		CryptoUtils.Bin2Hex(digest, 0, hex, 0, 16);
		ASSERT(hex = "900150983CD24FB0D6963F7D28E17F72")
	END Test.

positive: SHA-3 of what NIST says

	MODULE Test;
	IMPORT CryptoSHA3, CryptoUtils, Hashes := CryptoHashes;
	VAR h: Hashes.Hash; digest: ARRAY 64 OF CHAR; hex: ARRAY 128 OF CHAR; data: ARRAY 8 OF CHAR;
	BEGIN
		h := CryptoSHA3.NewHash(); h.SetNameAndSize("SHA3-256", 32); h.Initialize;
		data := ""; h.Update(data, 0, 0);
		h.GetHash(digest, 0);
		CryptoUtils.Bin2Hex(digest, 0, hex, 0, 32);
		ASSERT(hex = "A7FFC6F8BF1ED76651C14756A061D662F580FF4DE43B49FA82D80A4B80F8434A");

		h := CryptoSHA3.NewHash(); h.SetNameAndSize("SHA3-256", 32); h.Initialize;
		data := "abc"; h.Update(data, 0, 3);
		h.GetHash(digest, 0);
		CryptoUtils.Bin2Hex(digest, 0, hex, 0, 32);
		ASSERT(hex = "3A985DA74FE225B2045C172D6BD390BD855F086E3E9D525B46BFE24511431532")
	END Test.

positive: AES encrypts the block FIPS-197 encrypts, to the same bytes

	MODULE Test;
	IMPORT CryptoAES, CryptoUtils, Ciphers := CryptoCiphers;
	VAR cipher: Ciphers.Cipher; key, block: ARRAY 32 OF CHAR; hex: ARRAY 64 OF CHAR; i: SIGNED32;
	BEGIN
		(*	FIPS-197, appendix C.1: key 000102...0F, plaintext 00112233445566778899AABBCCDDEEFF,
			ciphertext 69C4E0D86A7B0430D8CDB78070B4C55A. Every implementation in the world agrees on
			these sixteen bytes, which is the only thing that makes a cipher useful. *)
		FOR i := 0 TO 15 DO key[i] := CHR(i) END;
		FOR i := 0 TO 15 DO block[i] := CHR(i * 17) END;
		cipher := CryptoAES.NewCipher();
		cipher.InitKey(key, 128);
		cipher.Encrypt(block, 0, 16);
		CryptoUtils.Bin2Hex(block, 0, hex, 0, 16);
		ASSERT(hex = "69C4E0D86A7B0430D8CDB78070B4C55A");
		cipher.Decrypt(block, 0, 16);
		FOR i := 0 TO 15 DO ASSERT(block[i] = CHR(i * 17)) END
	END Test.

positive: Base64 of what RFC 4648 says, padding and all

	MODULE Test;
	IMPORT CryptoBase64;
	VAR out: ARRAY 64 OF CHAR; back: ARRAY 64 OF CHAR; len: SIGNED32;
	BEGIN
		CryptoBase64.Encode("Oberon", 6, out);
		ASSERT(out = "T2Jlcm9u");
		CryptoBase64.Encode("a", 1, out);
		ASSERT(out = "YQ==");                       (* one byte, two pad characters *)
		CryptoBase64.Encode("ab", 2, out);
		ASSERT(out = "YWI=");
		len := CryptoBase64.Decode("T2Jlcm9u", back);
		back[len] := 0X;
		ASSERT(back = "Oberon");
		ASSERT(len = 6)
	END Test.

positive: HMAC-SHA256 of what RFC 4231 says

	MODULE Test;
	IMPORT CryptoHMAC, CryptoUtils;
	VAR mac: CryptoHMAC.HMac; key, data: ARRAY 64 OF CHAR;
		digest: ARRAY 64 OF CHAR; hex: ARRAY 128 OF CHAR; i: SIGNED32;
	BEGIN
		(*	RFC 4231, case 1: a key of twenty 0BH bytes over "Hi There". Everything that
			authenticates a message on a network stands on this agreeing with everyone else. *)
		FOR i := 0 TO 19 DO key[i] := 0BX END;
		NEW(mac, "CryptoSHA256");
		mac.Initialize(key, 20);
		data := "Hi There"; mac.Update(data, 0, 8);
		mac.GetMac(digest, 0);
		CryptoUtils.Bin2Hex(digest, 0, hex, 0, 32);
		ASSERT(hex = "B0344C61D8DB38535CA8AFCEAF0BF12B881DC200C9833DA726E9376C2E32CFF7");

		(* case 2: a short key, and a longer message *)
		NEW(mac, "CryptoSHA256");
		key := "Jefe"; mac.Initialize(key, 4);
		data := "what do ya want for nothing?"; mac.Update(data, 0, 28);
		mac.GetMac(digest, 0);
		CryptoUtils.Bin2Hex(digest, 0, hex, 0, 32);
		ASSERT(hex = "5BDCC146BF60754E6A042426089575C75A003F089D2739839DEC58B964EC3843")
	END Test.


positive: the block ciphers, each against the bytes its own test set names

	MODULE Test;
	IMPORT CryptoDES, CryptoDES3, CryptoBlowfish, CryptoCAST, CryptoIDEA, CryptoTwofish,
		CryptoUtils, Ciphers := CryptoCiphers;

	VAR cipher: Ciphers.Cipher; key, block, plain: ARRAY 32 OF CHAR; hex: ARRAY 80 OF CHAR;
		i: SIGNED32;

		(*	Encrypts the block, checks it against the vector, decrypts it and checks that what comes
			back is what went in. A cipher that agrees with the world one way and not the other is
			no better than one that agrees with nobody. *)
		PROCEDURE Check(cipher: Ciphers.Cipher; CONST keyHex, plainHex, cipherHex: ARRAY OF CHAR;
			keyBits, size: SIGNED32);
		VAR i: SIGNED32;
		BEGIN
			CryptoUtils.Hex2Bin(keyHex, 0, key, 0, keyBits DIV 8);
			CryptoUtils.Hex2Bin(plainHex, 0, plain, 0, size);
			FOR i := 0 TO size - 1 DO block[i] := plain[i] END;
			cipher.InitKey(key, keyBits);
			cipher.Encrypt(block, 0, size);
			CryptoUtils.Bin2Hex(block, 0, hex, 0, size);
			hex[2 * size] := 0X;      (* Bin2Hex writes its nibbles and nothing else, by design:
			                             it is made to write into the middle of a buffer, so the
			                             end of the string is the caller's business *)
			ASSERT(hex = cipherHex);
			cipher.Decrypt(block, 0, size);
			FOR i := 0 TO size - 1 DO ASSERT(block[i] = plain[i]) END
		END Check;

	BEGIN
		(*	DES, the vector every book prints: "Now is t" under the key 0123456789ABCDEF. Checked
			against another implementation before it was written down here, as were the three
			below it. *)
		Check(CryptoDES.NewCipher(), "0123456789ABCDEF", "4E6F772069732074", "3FA40E8A984D4815",
			64, 8);

		(* three keys the same is single DES done three times, which is single DES *)
		Check(CryptoDES3.NewCipher(), "0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF",
			"4E6F772069732074", "3FA40E8A984D4815", 192, 8);

		(* Blowfish, from Schneier's own set: nothing under nothing, and everything under everything *)
		Check(CryptoBlowfish.NewCipher(), "0000000000000000", "0000000000000000",
			"4EF997456198DD78", 64, 8);
		Check(CryptoBlowfish.NewCipher(), "FFFFFFFFFFFFFFFF", "FFFFFFFFFFFFFFFF",
			"51866FD5B85ECB8A", 64, 8);

		(* CAST-128, the vector in RFC 2144 *)
		Check(CryptoCAST.NewCipher(), "0123456712345678234567893456789A", "0123456789ABCDEF",
			"238B4FE5847E44B2", 128, 8);

		(* IDEA and Twofish, from their published sets *)
		Check(CryptoIDEA.NewCipher(), "00010002000300040005000600070008", "0000000100020003",
			"11FBED2B01986DE5", 128, 8);
		Check(CryptoTwofish.NewCipher(), "00000000000000000000000000000000",
			"00000000000000000000000000000000", "9F589F5CF6122C32B6BFEC2F2AE8C35A", 128, 16);

		(* and the same key twice gives the same bytes twice, which not every cipher object does *)
		cipher := CryptoDES.NewCipher();
		CryptoUtils.Hex2Bin("0123456789ABCDEF", 0, key, 0, 8);
		CryptoUtils.Hex2Bin("4E6F772069732074", 0, block, 0, 8);
		cipher.InitKey(key, 64); cipher.Encrypt(block, 0, 8);
		CryptoUtils.Hex2Bin("4E6F772069732074", 0, block, 0, 8);
		cipher.Encrypt(block, 0, 8);
		CryptoUtils.Bin2Hex(block, 0, hex, 0, 8); hex[16] := 0X;
		ASSERT(hex = "3FA40E8A984D4815");
		i := 0; ASSERT(i = 0)
	END Test.

positive: ARC4 makes the keystream RFC 6229 prints

	MODULE Test;
	IMPORT CryptoARC4, CryptoUtils, Ciphers := CryptoCiphers;
	VAR cipher: Ciphers.Cipher; key, block: ARRAY 32 OF CHAR; hex: ARRAY 80 OF CHAR; i: SIGNED32;
	BEGIN
		(*	A stream cipher applied to nothing is its keystream, and RFC 6229 prints the first
			sixteen bytes of it for the key 0102030405. Checked against another implementation. *)
		CryptoUtils.Hex2Bin("0102030405", 0, key, 0, 5);
		FOR i := 0 TO 15 DO block[i] := 0X END;
		cipher := CryptoARC4.NewCipher();
		cipher.InitKey(key, 40);
		cipher.Encrypt(block, 0, 16);
		CryptoUtils.Bin2Hex(block, 0, hex, 0, 16); hex[32] := 0X;
		ASSERT(hex = "B2396305F03DC027CCC3524A0A1118A8");

		(* and applying it again with the same key gives back what one started with *)
		cipher := CryptoARC4.NewCipher();
		cipher.InitKey(key, 40);
		cipher.Encrypt(block, 0, 16);
		FOR i := 0 TO 15 DO ASSERT(block[i] = 0X) END
	END Test.
