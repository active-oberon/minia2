# Tests for the compression package -- std/compress, which the registry calls stable.
#
# options --mayTrap --prolog="Compiler.Compile TesterInput.txt" --command="System.Free Test;System.Load Test"
#
# Eight modules, a tier of the standard library, marked stable, and nothing had ever compressed
# anything under a test. "Stable" is a promise, and a promise nobody checks is a wish.
#
# What is checked is the property that matters and not the bytes a particular version emits: what
# comes out of the decompressor is what went into the compressor, for text that compresses well,
# for data that does not, for the empty case and for something larger than the buffers inside.
# A round trip is the whole contract of a compressor; the exact encoding is its own business.
#
# Each case is positive: it must compile and run its module body without a failing ASSERT.

positive: text goes through compression and comes back the same

	MODULE Test;
	IMPORT Files, ZlibWriters, ZlibReaders, Strings;
	VAR f: Files.File; rider: Files.Rider; w: ZlibWriters.Writer; r: ZlibReaders.Reader;
		source, back: ARRAY 4096 OF CHAR; written, read, total: SIZE; i: SIGNED32;
	BEGIN
		source := "";
		FOR i := 1 TO 100 DO Strings.Append(source, "the same sentence over and over. ") END;

		f := Files.New("compress.tmp"); ASSERT(f # NIL);
		f.Set(rider, 0);
		ZlibWriters.Open(w, 6, 0, 0, TRUE, rider);
		ASSERT(w.res = ZlibWriters.Ok);
		ZlibWriters.WriteBytes(w, source, 0, Strings.Length(source), written);
		ASSERT(written = Strings.Length(source));
		ZlibWriters.Close(w);
		Files.Register(f);

		f := Files.Old("compress.tmp"); ASSERT(f # NIL);
		f.Set(rider, 0);
		ZlibReaders.Open(r, TRUE, rider);
		ASSERT(r.res = ZlibReaders.Ok);
		(*	A reader hands over what it has, as every reader does: asking for the whole of it in
			one call is not the contract, and a client loops until it has what it wanted or the
			stream says it is over. *)
		total := 0;
		REPEAT
			ZlibReaders.ReadBytes(r, back, total, Strings.Length(source) - total, read);
			INC(total, read)
		UNTIL (total = Strings.Length(source)) OR (read = 0);
		ASSERT(total = Strings.Length(source));
		back[total] := 0X;
		ASSERT(back = source)
	END Test.

positive: and it is smaller than what went in, which is the point of it

	MODULE Test;
	IMPORT Files, ZlibWriters, Strings;
	VAR f: Files.File; rider: Files.Rider; w: ZlibWriters.Writer;
		source: ARRAY 4096 OF CHAR; written: SIZE; i: SIGNED32;
	BEGIN
		source := "";
		FOR i := 1 TO 100 DO Strings.Append(source, "the same sentence over and over. ") END;
		f := Files.New("compress2.tmp"); f.Set(rider, 0);
		ZlibWriters.Open(w, 6, 0, 0, TRUE, rider);
		ZlibWriters.WriteBytes(w, source, 0, Strings.Length(source), written);
		ZlibWriters.Close(w);
		Files.Register(f);
		f := Files.Old("compress2.tmp");
		ASSERT(f.Length() > 0);
		ASSERT(f.Length() < Strings.Length(source) DIV 4)   (* a hundred copies of one sentence *)
	END Test.

positive: data that does not compress still comes back whole

	MODULE Test;
	IMPORT Files, ZlibWriters, ZlibReaders;
	VAR f: Files.File; rider: Files.Rider; w: ZlibWriters.Writer; r: ZlibReaders.Reader;
		source, back: ARRAY 2048 OF CHAR; written, read, total: SIZE; i: SIGNED32; seed: SIGNED32;
	BEGIN
		(* not random, but without a pattern a compressor can use *)
		seed := 12345;
		FOR i := 0 TO 2047 DO
			seed := (seed * 1103515245 + 12345) MOD 2147483647;
			source[i] := CHR(seed MOD 256)
		END;
		f := Files.New("compress3.tmp"); f.Set(rider, 0);
		ZlibWriters.Open(w, 9, 0, 0, TRUE, rider);
		ZlibWriters.WriteBytes(w, source, 0, 2048, written);
		ASSERT(written = 2048);
		ZlibWriters.Close(w); Files.Register(f);

		f := Files.Old("compress3.tmp"); f.Set(rider, 0);
		ZlibReaders.Open(r, TRUE, rider);
		total := 0;
		REPEAT
			ZlibReaders.ReadBytes(r, back, total, 2048 - total, read); INC(total, read)
		UNTIL (total = 2048) OR (read = 0);
		ASSERT(total = 2048);
		FOR i := 0 TO 2047 DO ASSERT(back[i] = source[i]) END
	END Test.

positive: more than fits in the buffers inside

	MODULE Test;
	IMPORT Files, ZlibWriters, ZlibReaders;
	VAR f: Files.File; rider: Files.Rider; w: ZlibWriters.Writer; r: ZlibReaders.Reader;
		source, back: POINTER TO ARRAY OF CHAR; written, read, total: SIZE; i: SIGNED32;
	BEGIN
		NEW(source, 200000); NEW(back, 200000);
		FOR i := 0 TO 199999 DO source[i] := CHR(ORD("a") + i MOD 26) END;
		f := Files.New("compress4.tmp"); f.Set(rider, 0);
		ZlibWriters.Open(w, 6, 0, 0, TRUE, rider);
		ZlibWriters.WriteBytes(w, source^, 0, 200000, written);
		ASSERT(written = 200000);
		ZlibWriters.Close(w); Files.Register(f);

		f := Files.Old("compress4.tmp"); f.Set(rider, 0);
		ZlibReaders.Open(r, TRUE, rider);
		total := 0;
		REPEAT
			ZlibReaders.ReadBytes(r, back^, total, 200000 - total, read); INC(total, read)
		UNTIL (total = 200000) OR (read = 0);
		ASSERT(total = 200000);
		FOR i := 0 TO 199999 DO ASSERT(back[i] = source[i]) END
	END Test.

positive: without the zlib wrapper it is the same story

	MODULE Test;
	IMPORT Files, ZlibWriters, ZlibReaders, Strings;
	VAR f: Files.File; rider: Files.Rider; w: ZlibWriters.Writer; r: ZlibReaders.Reader;
		source, back: ARRAY 1024 OF CHAR; written, read: SIZE;
	BEGIN
		source := "raw deflate, no header and no checksum around it";
		f := Files.New("compress5.tmp"); f.Set(rider, 0);
		ZlibWriters.Open(w, 6, 0, 0, FALSE, rider);
		ZlibWriters.WriteBytes(w, source, 0, Strings.Length(source), written);
		ZlibWriters.Close(w); Files.Register(f);

		f := Files.Old("compress5.tmp"); f.Set(rider, 0);
		ZlibReaders.Open(r, FALSE, rider);
		ZlibReaders.ReadBytes(r, back, 0, Strings.Length(source), read);
		ASSERT(read = Strings.Length(source));
		back[read] := 0X;
		ASSERT(back = source)
	END Test.

positive: the checksum of known bytes is the known number

	MODULE Test;
	IMPORT Zlib;
	VAR data: ARRAY 16 OF CHAR;
	BEGIN
		(*	CRC-32 of "123456789" is CBF43926, which is the check value every implementation of it
			quotes. A round trip cannot catch a checksum that is wrong the same way at both ends;
			this can. *)
		data := "123456789";
		ASSERT(Zlib.CRC32(0, data, 0, 9) = SIGNED32(0CBF43926H))
	END Test.

positive: a stream another implementation made is read by ours

	MODULE Test;
	IMPORT Files, ZlibReaders;
	CONST
		(*	zlib.compress(b"...", 6) from a Python that has nothing to do with this tree. A round
			trip cannot tell whether both ends are wrong together; this can. It is also what the
			defect above looked like from outside: a writer asked for a zlib stream wrote a raw
			deflate one, and only a stream from elsewhere would have shown it. *)
		hex = "789C15CAC10D80400804C056B6009B82DC26921C6038EEA1D5ABF31EC1334DB1BA280E9741E80D89EC9305F36BD2192D6D19073AA1C457C7BF72D77A01F7B7175E";
		length = 64;
	VAR f: Files.File; rider: Files.Rider; r: ZlibReaders.Reader;
		blob, back: ARRAY 256 OF CHAR; i, n: SIGNED32; read, total: SIZE;

		PROCEDURE Digit (c: CHAR): SIGNED32;
		BEGIN
			IF (c >= "0") & (c <= "9") THEN RETURN ORD(c) - ORD("0") END;
			RETURN ORD(c) - ORD("A") + 10
		END Digit;

	BEGIN
		n := 0; i := 0;
		WHILE hex[i] # 0X DO
			blob[n] := CHR(Digit(hex[i]) * 16 + Digit(hex[i+1])); INC(n); INC(i, 2)
		END;
		f := Files.New("outside.tmp"); f.Set(rider, 0);
		rider.file.WriteBytes(rider, blob, 0, n);
		Files.Register(f);

		f := Files.Old("outside.tmp"); f.Set(rider, 0);
		ZlibReaders.Open(r, TRUE, rider);
		ASSERT(r.res = ZlibReaders.Ok);
		total := 0;
		REPEAT
			ZlibReaders.ReadBytes(r, back, total, length - total, read); INC(total, read)
		UNTIL (total = length) OR (read = 0);
		ASSERT(total = length);
		back[total] := 0X;
		ASSERT(back = "a zlib stream made by another implementation, to be read by ours")
	END Test.

# -------------------------
# The rest of the package, which the cases above never touched: gzip as a container, the standalone
# inflate of RFC 1951, the Burrows-Wheeler compressor and the move-to-front transformation under it.
# -------------------------

positive: a file through gzip and back is the file

	MODULE Test;
	IMPORT Files, GZip, Strings;
	VAR source, packed, back: Files.File; rider: Files.Rider;
		text, read: ARRAY 8192 OF CHAR; i: SIGNED32; n: SIZE;
	BEGIN
		text := "";
		FOR i := 0 TO 99 DO Strings.Append(text, "a line that repeats and therefore compresses. ") END;
		n := Strings.Length(text);

		source := Files.New("plain.tmp"); source.Set(rider, 0);
		rider.file.WriteBytes(rider, text, 0, n);
		Files.Register(source);

		(*	level 6, the default strategy, and the flush the module's own command uses. The
			container is what is being tested here, not the ratio. *)
		packed := Files.New("packed.tmp");
		GZip.Deflate(Files.Old("plain.tmp"), packed, 6, 0, 0);
		Files.Register(packed);
		ASSERT(Files.Old("packed.tmp") # NIL);
		ASSERT(Files.Old("packed.tmp").Length() < n);	(* it is a compressor, after all *)

		back := Files.New("back.tmp");
		GZip.Inflate(Files.Old("packed.tmp"), back);
		Files.Register(back);

		back := Files.Old("back.tmp");
		ASSERT(back.Length() = n);
		back.Set(rider, 0); rider.file.ReadBytes(rider, read, 0, n);
		read[n] := 0X;
		ASSERT(read = text)
	END Test.

positive: a gzip stream another implementation made is read by ours

	MODULE Test;
	IMPORT Files, GZip;
	CONST
		(*	gzip.GzipFile from a Python that has nothing to do with this tree, level 6, the time
			stamp zeroed so the bytes are the same on every run. A round trip cannot tell whether
			both ends agree on a container nobody else would recognise. *)
		hex = "1F8B08000000000000FF15CA410E80300804C0AFEC03FC144D374A52A0A178D0D757E73C82F3D5895549319874A23D108FBA98509B83462F290D3F5081467CB5FF2BEE5C1BB8304B0C40000000";
		length = 64;
	VAR f, out: Files.File; rider: Files.Rider; blob, back: ARRAY 256 OF CHAR; i, n: SIGNED32;

		PROCEDURE Digit (c: CHAR): SIGNED32;
		BEGIN
			IF (c >= "0") & (c <= "9") THEN RETURN ORD(c) - ORD("0") END;
			RETURN ORD(c) - ORD("A") + 10
		END Digit;

	BEGIN
		n := 0; i := 0;
		WHILE hex[i] # 0X DO
			blob[n] := CHR(Digit(hex[i]) * 16 + Digit(hex[i+1])); INC(n); INC(i, 2)
		END;
		f := Files.New("outside.gz"); f.Set(rider, 0);
		rider.file.WriteBytes(rider, blob, 0, n);
		Files.Register(f);

		out := Files.New("outside.txt");
		GZip.Inflate(Files.Old("outside.gz"), out);
		Files.Register(out);

		out := Files.Old("outside.txt");
		ASSERT(out.Length() = length);
		out.Set(rider, 0); rider.file.ReadBytes(rider, back, 0, length);
		back[length] := 0X;
		ASSERT(back = "a gzip stream made by another implementation, to be read by ours")
	END Test.

positive: the standalone inflate reads a deflate stream with no wrapper on it

	MODULE Test;
	IMPORT Files, Streams, Inflate;
	CONST
		(*	zlib.compressobj(6, DEFLATED, -15) -- RFC 1951 and nothing around it, which is what this
			module reads. The two bytes of a zlib header and the four of its checksum are exactly
			what the comment at the top of Inflate.Mod says have to be off. *)
		hex = "15CA410E80300804C0AFEC03FC144D374A52A0A178D0D757E73C82F3D5895549319874A23D108FBA98509B83462F290D3F5081467CB5FF2BEE5C1B";
		length = 64;
	VAR f: Files.File; rider: Files.Rider; in: Files.Reader; r: Inflate.Reader;
		blob, back: ARRAY 256 OF CHAR; i, n: SIGNED32; read, total: SIZE;

		PROCEDURE Digit (c: CHAR): SIGNED32;
		BEGIN
			IF (c >= "0") & (c <= "9") THEN RETURN ORD(c) - ORD("0") END;
			RETURN ORD(c) - ORD("A") + 10
		END Digit;

	BEGIN
		n := 0; i := 0;
		WHILE hex[i] # 0X DO
			blob[n] := CHR(Digit(hex[i]) * 16 + Digit(hex[i+1])); INC(n); INC(i, 2)
		END;
		f := Files.New("raw.tmp"); f.Set(rider, 0);
		rider.file.WriteBytes(rider, blob, 0, n);
		Files.Register(f);

		Files.OpenReader(in, Files.Old("raw.tmp"), 0);
		Inflate.OpenReader(r, in);
		total := 0;
		REPEAT
			r.Bytes(back, total, length - total, read); INC(total, read)
		UNTIL (total = length) OR (read = 0);
		ASSERT(total = length);
		back[total] := 0X;
		ASSERT(back = "a gzip stream made by another implementation, to be read by ours")
	END Test.

positive: the Burrows-Wheeler compressor gives back what it was given

	MODULE Test;
	IMPORT Streams, BWHCompressor, Strings;

	VAR text, packed, back: ARRAY 8192 OF CHAR;

	PROCEDURE Trip (CONST source: ARRAY OF CHAR; length: SIZE): SIZE;
	VAR in, mid: Streams.StringReader; out, plain: Streams.StringWriter; n, m: SIZE;
	BEGIN
		NEW(in, length + 1); in.SetRaw(source, 0, length);
		Streams.OpenStringWriter(out, LEN(packed));
		BWHCompressor.Compress(in, out);
		out.Update; out.GetRaw(packed, n);

		NEW(mid, n + 1); mid.SetRaw(packed, 0, n);
		Streams.OpenStringWriter(plain, LEN(back));
		BWHCompressor.Expand(mid, plain);
		plain.Update; plain.GetRaw(back, m);
		RETURN m
	END Trip;

	VAR i: SIGNED32; length: SIZE;

	BEGIN
		(* text that compresses *)
		text := "";
		FOR i := 0 TO 99 DO Strings.Append(text, "the same line again and again. ") END;
		length := Strings.Length(text);
		ASSERT(Trip(text, length) = length, 1);
		back[length] := 0X;
		ASSERT(back = text, 2);

		(* and bytes that do not: every value of a byte, in an order it cannot predict *)
		FOR i := 0 TO 2047 DO text[i] := CHR((i * 37 + 11) MOD 256) END;
		ASSERT(Trip(text, 2048) = 2048, 3);
		FOR i := 0 TO 2047 DO ASSERT(back[i] = text[i], 4) END
	END Test.

positive: move to front says nothing twice

	MODULE Test;
	IMPORT MoveToFront;

	VAR encoder, decoder: MoveToFront.MTF; i: SIGNED32;
		source, coded: ARRAY 512 OF CHAR;

	BEGIN
		(*	The transformation under the Burrows-Wheeler compressor: a character just seen becomes
			0X, which is what turns a sorted block into a stream of small numbers. Encoder and
			decoder each keep their own alphabet, so they are two objects and not one. *)
		NEW(encoder); NEW(decoder);
		ASSERT(encoder.Encode("a") = CHR(ORD("a")), 1);		(* the first one is where it started *)
		ASSERT(encoder.Encode("a") = 0X, 2);				(* and now it is at the front *)
		ASSERT(encoder.Encode("a") = 0X, 3);

		NEW(encoder); NEW(decoder);
		FOR i := 0 TO 255 DO source[i] := CHR((i * 91 + 7) MOD 256) END;
		FOR i := 0 TO 255 DO coded[i] := encoder.Encode(source[i]) END;
		FOR i := 0 TO 255 DO ASSERT(decoder.Decode(coded[i]) = source[i], 5) END
	END Test.

positive: the file tool compresses and expands, and knows its own files

	MODULE Test;
	IMPORT Commands, Files, Streams, Strings;

	VAR f: Files.File; rider: Files.Rider; text, back, said: ARRAY 4096 OF CHAR;
		i: SIGNED32; n: SIZE;

	(** A command run over string streams; the result is the command's own context.result. *)
	PROCEDURE Run (CONST command, argument: ARRAY OF CHAR; VAR text: ARRAY OF CHAR): INTEGER;
	VAR context: Commands.Context; arg: Streams.StringReader; out: Streams.StringWriter;
		result: INTEGER; message: ARRAY 256 OF CHAR;
	BEGIN
		NEW(arg, LEN(argument)); arg.Set(argument);
		Streams.OpenStringWriter(out, 4096);
		NEW(context, NIL, arg, out, out, NIL);
		Commands.Activate(command, context, {Commands.Wait}, result, message);
		out.Get(text);
		RETURN result
	END Run;

	BEGIN
		text := "";
		FOR i := 0 TO 49 DO Strings.Append(text, "a line the tool will squeeze. ") END;
		n := Strings.Length(text);
		f := Files.New("tool.tmp"); f.Set(rider, 0);
		rider.file.WriteBytes(rider, text, 0, n);
		Files.Register(f);

		(*	The tool writes its own four-byte tag in front of the stream, so it can tell a file of
			its own from any other -- and the suffix it appends is how it names the result. *)
		ASSERT(Run("OZip3.Compress", "tool.tmp", said) = 0, 1);
		ASSERT(Files.Old("tool.tmp.oz3") # NIL, 2);
		ASSERT(Files.Old("tool.tmp.oz3").Length() < n, 3);

		ASSERT(Run("OZip3.Expand", "tool.tmp.oz3 back.tmp", said) = 0, 4);
		f := Files.Old("back.tmp");
		ASSERT(f # NIL, 5);
		ASSERT(f.Length() = n, 6);
		f.Set(rider, 0); rider.file.ReadBytes(rider, back, 0, n);
		back[n] := 0X;
		ASSERT(back = text, 7);

		(* a file that is not one of its own is refused by the tag and not by the name *)
		ASSERT(Run("OZip3.Expand", "tool.tmp other.tmp", said) = 0, 8);
		ASSERT(Strings.Pos("not OZip3 compressed", said) >= 0, 9);
		ASSERT(Files.Old("other.tmp") = NIL, 10)
	END Test.

