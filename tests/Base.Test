# Tests for std/base -- the odds and ends the rest of the tree leans on.
#
# options --mayTrap --prolog="Compiler.Compile TesterInput.txt" --command="System.Free Test;System.Load Test"
#
# A string that grows on its own, a list and a sorted list, and the 16.16 fixed-point arithmetic
# the graphics use. None of them had a test. What each is asked is what it promises: a string that
# is the characters put into it however many there are, a sorted list that is sorted after every
# insertion rather than after the last, and a fixed-point number that is the number it stands for.
#
# Each case is positive: it must compile and run its module body without a failing ASSERT.

positive: a string that grows as it is written

	MODULE Test;
	IMPORT DynamicStrings, Strings;

	VAR string: DynamicStrings.DynamicString; out: Strings.String; i: SIZE;
	BEGIN
		NEW(string);
		ASSERT(string.Length() = 0);

		string.Append("hello");
		ASSERT(string.Length() = 5);
		out := string.ToArrOfChar();
		ASSERT(out^ = "hello");

		string.Append(", world");
		ASSERT(string.Length() = 12);
		out := string.ToArrOfChar();
		ASSERT(out^ = "hello, world");

		(* one character at a time, past whatever it was first given *)
		NEW(string);
		FOR i := 0 TO 999 DO string.AppendCharacter("x") END;
		ASSERT(string.Length() = 1000);
		out := string.ToArrOfChar();
		ASSERT(out[0] = "x"); ASSERT(out[999] = "x"); ASSERT(out[1000] = 0X);

		(* read and written by position *)
		NEW(string); string.Append("abcdef");
		ASSERT(string.Get(0) = "a");
		ASSERT(string.Get(5) = "f");
		string.Put("Z", 0);
		ASSERT(string.Get(0) = "Z");
		out := string.ToArrOfChar();
		ASSERT(out^ = "Zbcdef");

		(* a piece taken out of the middle *)
		out := string.Extract(1, 3);
		ASSERT(out^ = "bcd");
		out := string.Extract(0, 6);
		ASSERT(out^ = "Zbcdef");

		(* compared, with and without regard to case *)
		ASSERT(string.EqualsTo("Zbcdef", FALSE));
		ASSERT(~string.EqualsTo("zBCDEF", FALSE));
		ASSERT(string.EqualsTo("zBCDEF", TRUE));
		ASSERT(~string.EqualsTo("something else", TRUE));

		(* and emptied *)
		string.Clear;
		ASSERT(string.Length() = 0);
		out := string.ToArrOfChar();
		ASSERT(out^ = "")
	END Test.

positive: a list, and a list that keeps itself sorted

	MODULE Test;
	IMPORT TFClasses;

	TYPE Item = OBJECT VAR n: SIGNED32; PROCEDURE &Set*(n: SIGNED32); BEGIN SELF.n := n END Set END Item;

	VAR list: TFClasses.List; sorted: TFClasses.SortedList; item, a, b, c: Item; i: SIZE;

		PROCEDURE Compare(first, second: ANY): INTEGER;
		BEGIN
			IF first(Item).n < second(Item).n THEN RETURN -1
			ELSIF first(Item).n > second(Item).n THEN RETURN 1
			ELSE RETURN 0
			END
		END Compare;

	BEGIN
		NEW(list);
		ASSERT(list.GetCount() = 0);
		NEW(a, 1); NEW(b, 2); NEW(c, 3);
		list.Add(a); list.Add(b); list.Add(c);
		ASSERT(list.GetCount() = 3);
		ASSERT(list.GetItem(0) = a);
		ASSERT(list.GetItem(2) = c);

		list.Remove(b);
		ASSERT(list.GetCount() = 2);
		ASSERT(list.GetItem(0) = a);
		ASSERT(list.GetItem(1) = c);                  (* what was behind it moved up *)

		list.Replace(a, b);
		ASSERT(list.GetItem(0) = b);
		ASSERT(list.GetCount() = 2);

		list.Clear;
		ASSERT(list.GetCount() = 0);

		(* many, to make it grow more than once *)
		FOR i := 1 TO 500 DO NEW(item, SIGNED32(i)); list.Add(item) END;
		ASSERT(list.GetCount() = 500);
		ASSERT(list.GetItem(0)(Item).n = 1);
		ASSERT(list.GetItem(499)(Item).n = 500);

		(* and the sorted one, which has to be in order after every insertion *)
		NEW(sorted, Compare);
		NEW(item, 5); sorted.Add(item);
		NEW(item, 1); sorted.Add(item);
		NEW(item, 3); sorted.Add(item);
		NEW(item, 2); sorted.Add(item);
		NEW(item, 4); sorted.Add(item);
		ASSERT(sorted.GetCount() = 5);
		FOR i := 0 TO 4 DO ASSERT(sorted.GetItem(i)(Item).n = SIGNED32(i) + 1) END;

		(* found by what it holds rather than by which one it is *)
		NEW(item, 3);
		ASSERT(sorted.SearchByKey(item) # NIL);
		ASSERT(sorted.SearchByKey(item)(Item).n = 3);
		NEW(item, 99);
		ASSERT(sorted.SearchByKey(item) = NIL)
	END Test.

positive: sixteen bits either side of the point

	MODULE Test;
	IMPORT FP1616;

	VAR x: SIGNED32;
	BEGIN
		(* a whole number is itself, shifted up *)
		ASSERT(FP1616.FloatToFixp(1.0) = 65536);
		ASSERT(FP1616.FloatToFixp(0.0) = 0);
		ASSERT(FP1616.FloatToFixp(-1.0) = -65536);
		ASSERT(FP1616.FloatToFixp(0.5) = 32768);
		ASSERT(FP1616.FloatToFixp(2.5) = 163840);

		(* and back again *)
		ASSERT(FP1616.FixpToFloat(65536) = 1.0);
		ASSERT(FP1616.FixpToFloat(32768) = 0.5);
		ASSERT(FP1616.FixpToFloat(-65536) = -1.0);
		ASSERT(FP1616.FixpToFloat(0) = 0.0);

		(* the whole part of it, rounded down as a floor and not toward zero *)
		ASSERT(FP1616.Int(65536) = 1);
		ASSERT(FP1616.Int(98304) = 1);                 (* one and a half *)
		ASSERT(FP1616.Int(0) = 0);
		ASSERT(FP1616.Int(-65536) = -1);

		(* multiplied and divided in the same units they came in *)
		x := FP1616.Mult(FP1616.FloatToFixp(2.0), FP1616.FloatToFixp(3.0));
		ASSERT(x = FP1616.FloatToFixp(6.0));
		x := FP1616.Mult(FP1616.FloatToFixp(0.5), FP1616.FloatToFixp(0.5));
		ASSERT(x = FP1616.FloatToFixp(0.25));
		x := FP1616.Div(FP1616.FloatToFixp(6.0), FP1616.FloatToFixp(3.0));
		ASSERT(x = FP1616.FloatToFixp(2.0));
		x := FP1616.Div(FP1616.FloatToFixp(1.0), FP1616.FloatToFixp(4.0));
		ASSERT(x = FP1616.FloatToFixp(0.25));

		(*	A number too large to be held has to come back as the largest that can be, and not as
			some small number: what saturates must stay big. *)
		ASSERT(FP1616.FloatToFixp(100000.0) > 65536);
		ASSERT(FP1616.FloatToFixp(-100000.0) < -65536)
	END Test.
