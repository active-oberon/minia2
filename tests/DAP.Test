# Tests for source/DAP.Mod -- the debug adapter, driven in this process.
#
# options --mayTrap --prolog="Compiler.Compile TesterInput.txt" --command="System.Free Test DAPTestShared;System.Load Test"
#
# The adapter speaks DAP over a Commands.Context, so a case needs no pipe and no second process:
# the requests are a string of framed messages, the answers are collected as they are written, and
# read back with our own JSON.
#
# A conversation with a debugger is not a script, though. An editor asks for a stack only after it
# has been told the program stopped, and so does this: the Wire below feeds its input in three
# parts, releasing each when one more "stopped" event has come out. A case that queued everything
# at once would race the program it launched and read an empty stack half the time.
#
# A breakpoint needs a line table, and the harness compiles a case without --debug, so the cases
# that set one compile their own fixture in this process -- the same trick tests/DebugMap.Test uses,
# and for the same reason.
#
# The trap dump these cases print is theirs: a program that traps is what is being debugged here.

positive: the helpers these tests are written with

	MODULE DAPTestShared;	(** AUTHOR "Andrii Puhachenko"; PURPOSE "Drive the debug adapter in this process" *)

	IMPORT Commands, Compiler, DebugMap, Diagnostics, Objects, Streams, Strings,
		SyntaxTree := FoxSyntaxTree, JSON, DAP;

	CONST
		CR = 0DX; LF = 0AX;

	VAR
		sumLine-, incLine-: SIGNED32;   (* the lines of the fixture worth stopping on *)
		written: SIGNED32;

	TYPE
		Text* = ARRAY 4096 OF CHAR;

		(*	The input stream and the transcript in one object, because the two are tied: the tail of
			the input is released by what appears in the transcript. *)
		Wire* = OBJECT
		VAR
			input: Text; split: ARRAY 3 OF SIZE; position: SIZE;
			transcript-: ARRAY 32768 OF CHAR; length: SIZE;
			stops: SIGNED32;
			message-: ARRAY 64 OF JSON.Value; count-: SIGNED32;

			PROCEDURE &Init* (CONST head, tail, rest: ARRAY OF CHAR);
			BEGIN
				COPY(head, input); split[0] := Strings.Length(input);
				Strings.Append(input, tail); split[1] := Strings.Length(input);
				Strings.Append(input, rest); split[2] := Strings.Length(input);
				position := 0; length := 0; transcript[0] := 0X; stops := 0; count := 0
			END Init;

			(* How much of the input is readable: one part more for every stop reported. *)
			PROCEDURE Limit (): SIZE;
			BEGIN
				IF stops >= 2 THEN RETURN split[2]
				ELSIF stops = 1 THEN RETURN split[1]
				ELSE RETURN split[0]
				END
			END Limit;

			PROCEDURE Await;
			BEGIN {EXCLUSIVE}
				AWAIT(position < Limit())
			END Await;

			(** The reader the adapter reads its requests from. *)
			PROCEDURE Receive* (VAR buf: ARRAY OF CHAR; ofs, size, min: SIZE; VAR len: SIZE; VAR res: INTEGER);
			VAR limit: SIZE;
			BEGIN
				(* nothing is held back when nothing is left to hold *)
				IF (position >= Limit()) & (Limit() < split[2]) THEN Await END;
				limit := Limit();
				IF position >= limit THEN len := 0; res := Streams.EOF; RETURN END;
				len := 0;
				WHILE (len < size) & (position + len < limit) DO
					buf[ofs + len] := input[position + len]; INC(len)
				END;
				position := position + len; res := Streams.Ok
			END Receive;

			(** The writer the adapter answers on. Two activities write here, so it is a monitor. *)
			PROCEDURE Send* (CONST buf: ARRAY OF CHAR; ofs, len: SIZE; propagate: BOOLEAN; VAR res: INTEGER);
			VAR i: SIZE;
			BEGIN {EXCLUSIVE}
				FOR i := 0 TO len - 1 DO
					IF length < LEN(transcript) - 1 THEN transcript[length] := buf[ofs + i]; INC(length) END
				END;
				transcript[length] := 0X;
				res := Streams.Ok;
				stops := Occurrences(transcript, '"event":"stopped"')
			END Send;

			(** Everything that came back, once the conversation is over. *)
			PROCEDURE Collect*;
			VAR position: SIZE; body: Strings.String; value: JSON.Value;
			BEGIN
				position := 0; count := 0;
				WHILE (count < LEN(message)) & NextBody(transcript, position, body) DO
					IF JSON.Parse(body^, value) THEN message[count] := value; INC(count) END
				END
			END Collect;

			(** The response to the request with this sequence number, or NIL. *)
			PROCEDURE Answer* (seq: SIGNED32): JSON.Object;
			VAR i, answered: SIGNED32; object: JSON.Object; kind: Strings.String;
			BEGIN
				FOR i := 0 TO count - 1 DO
					object := JSON.AsObject(message[i]);
					IF (object # NIL) & JSON.GetString(object, "type", kind) & (kind^ = "response")
							& JSON.GetInteger(object, "request_seq", answered) & (answered = seq) THEN
						RETURN object
					END
				END;
				RETURN NIL
			END Answer;

			(** The body of the first event of this name, or NIL. *)
			PROCEDURE Event* (CONST name: ARRAY OF CHAR): JSON.Object;
			VAR i: SIGNED32; object: JSON.Object; kind, event: Strings.String;
			BEGIN
				FOR i := 0 TO count - 1 DO
					object := JSON.AsObject(message[i]);
					IF (object # NIL) & JSON.GetString(object, "type", kind) & (kind^ = "event")
							& JSON.GetString(object, "event", event) & (event^ = name) THEN
						RETURN JSON.AsObject(object.Get("body"))
					END
				END;
				RETURN NIL
			END Event;

			(** The body of the n-th event of this name, counting from 0, or NIL. *)
			PROCEDURE Nth* (CONST name: ARRAY OF CHAR; n: SIGNED32): JSON.Object;
			VAR i, seen: SIGNED32; object: JSON.Object; kind, event: Strings.String;
			BEGIN
				seen := 0;
				FOR i := 0 TO count - 1 DO
					object := JSON.AsObject(message[i]);
					IF (object # NIL) & JSON.GetString(object, "type", kind) & (kind^ = "response") THEN
						(* a response is not an event *)
					ELSIF (object # NIL) & JSON.GetString(object, "event", event) & (event^ = name) THEN
						IF seen = n THEN RETURN JSON.AsObject(object.Get("body")) END;
						INC(seen)
					END
				END;
				RETURN NIL
			END Nth;

			PROCEDURE Seen* (CONST name: ARRAY OF CHAR): BOOLEAN;
			VAR i: SIGNED32; object: JSON.Object; kind, event: Strings.String;
			BEGIN
				FOR i := 0 TO count - 1 DO
					object := JSON.AsObject(message[i]);
					IF (object # NIL) & JSON.GetString(object, "type", kind) & (kind^ = "event")
							& JSON.GetString(object, "event", event) & (event^ = name) THEN
						RETURN TRUE
					END
				END;
				RETURN FALSE
			END Seen;
		END Wire;

	(** One framed request, appended to a message string. *)
	PROCEDURE Request* (VAR to: ARRAY OF CHAR; seq: SIGNED32; CONST command, arguments: ARRAY OF CHAR);
	VAR body: Text;
	BEGIN
		body := '{"seq":'; Strings.AppendInt(body, seq);
		Strings.Append(body, ',"type":"request","command":"'); Strings.Append(body, command);
		Strings.Append(body, '","arguments":'); Strings.Append(body, arguments);
		Strings.Append(body, "}");
		Strings.Append(to, "Content-Length: ");
		Strings.AppendInt(to, SIGNED32(Strings.Length(body)));
		Strings.AppendChar(to, CR); Strings.AppendChar(to, LF);
		Strings.AppendChar(to, CR); Strings.AppendChar(to, LF);
		Strings.Append(to, body)
	END Request;

	PROCEDURE Contains* (CONST text, pattern: ARRAY OF CHAR): BOOLEAN;
	VAR i, j: SIZE;
	BEGIN
		i := 0;
		WHILE text[i] # 0X DO
			j := 0;
			WHILE (pattern[j] # 0X) & (text[i + j] = pattern[j]) DO INC(j) END;
			IF pattern[j] = 0X THEN RETURN TRUE END;
			INC(i)
		END;
		RETURN FALSE
	END Contains;

	(** How many times a pattern appears. *)
	PROCEDURE Occurrences* (CONST text, pattern: ARRAY OF CHAR): SIGNED32;
	VAR i, j: SIZE; n: SIGNED32;
	BEGIN
		i := 0; n := 0;
		WHILE text[i] # 0X DO
			j := 0;
			WHILE (pattern[j] # 0X) & (text[i + j] = pattern[j]) DO INC(j) END;
			IF pattern[j] = 0X THEN INC(n) END;
			INC(i)
		END;
		RETURN n
	END Occurrences;

	(* The next framed body in a transcript, from `position`. *)
	PROCEDURE NextBody* (CONST text: ARRAY OF CHAR; VAR position: SIZE; VAR body: Strings.String): BOOLEAN;
	CONST prefix = "Content-Length:";
	VAR i, j, start: SIZE; n: SIZE;
	BEGIN
		i := position;
		LOOP
			IF text[i] = 0X THEN RETURN FALSE END;
			j := 0;
			WHILE (prefix[j] # 0X) & (text[i + j] = prefix[j]) DO INC(j) END;
			IF prefix[j] = 0X THEN EXIT END;
			INC(i)
		END;
		i := i + Strings.Length(prefix);
		WHILE text[i] = " " DO INC(i) END;
		n := 0;
		WHILE (text[i] >= "0") & (text[i] <= "9") DO n := n * 10 + (ORD(text[i]) - ORD("0")); INC(i) END;
		WHILE (text[i] # 0X) & ~((text[i] = LF) & (text[i - 2] = LF)) DO INC(i) END;   (* CR LF CR LF *)
		IF text[i] = 0X THEN RETURN FALSE END;
		INC(i); start := i;
		NEW(body, n + 1);
		FOR j := 0 TO n - 1 DO body[j] := text[start + j] END;
		body[n] := 0X;
		position := start + n;
		RETURN TRUE
	END NextBody;

	(** Boom traps, which is the whole point of it: this is the program under debug. *)
	PROCEDURE Boom* (steps: SIGNED32): SIGNED32;
	VAR half: SIGNED32;
	BEGIN
		half := steps DIV 2;
		ASSERT(half > 1000);        (* fails, and the session is opened on the frame that failed *)
		RETURN half
	END Boom;

	(** The launcher a case gives the adapter instead of the compiler. *)
	PROCEDURE Crash* (CONST program, procedure: ARRAY OF CHAR; out: Streams.Writer;
			ready: DAP.Ready; VAR message: ARRAY OF CHAR): BOOLEAN;
	VAR ignore: SIGNED32;
	BEGIN
		out.String("running "); out.String(program); out.Ln; out.Update;
		ignore := Boom(84);
		COPY("never reached", message);
		RETURN TRUE
	END Crash;

	(** A program that ends the way most programs do. *)
	PROCEDURE Quiet* (CONST program, procedure: ARRAY OF CHAR; out: Streams.Writer;
			ready: DAP.Ready; VAR message: ARRAY OF CHAR): BOOLEAN;
	BEGIN
		out.String("done"); out.Ln; out.Update;
		COPY("", message);
		RETURN TRUE
	END Quiet;

	(*	--- the fixture the breakpoint cases debug ------------------------------------------
		A line is never written down as a number: it is recorded while the source is built, so
		editing the fixture cannot make a case wrong. *)

	PROCEDURE Say (VAR text: ARRAY OF CHAR; CONST line: ARRAY OF CHAR);
	BEGIN
		Strings.Append(text, line); Strings.AppendChar(text, 0AX); INC(written)
	END Say;

	(**	Build writes a program with a loop in it, under the name the case asked for -- a name of
		its own per case, because a module already loaded is not compiled again. *)
	PROCEDURE Build* (CONST name: ARRAY OF CHAR; VAR text: ARRAY OF CHAR);
	VAR line: Text;
	BEGIN
		text := ""; written := 0;
		line := "MODULE "; Strings.Append(line, name); Strings.AppendChar(line, ";");
		Say(text, line);
		Say(text, "IMPORT Commands;");
		Say(text, "PROCEDURE Count* (n: SIGNED32): SIGNED32;");
		Say(text, "VAR i, sum: SIGNED32;");
		Say(text, "BEGIN");
		Say(text, "	sum := 0;");
		Say(text, "	i := 0;");
		Say(text, "	WHILE i < n DO");
		sumLine := written + 1;
		Say(text, "		sum := sum + i;");
		incLine := written + 1;
		Say(text, "		INC(i)");
		Say(text, "	END;");
		Say(text, "	RETURN sum");
		Say(text, "END Count;");
		Say(text, "PROCEDURE Do* (context: Commands.Context);");
		Say(text, "BEGIN");
		Say(text, 'context.out.String("sum="); context.out.Int(Count(5), 0); context.out.Ln;');
		Say(text, "	context.out.Update");
		Say(text, "END Do;");
		line := "END "; Strings.Append(line, name); Strings.AppendChar(line, ".");
		Say(text, line)
	END Build;

	(*	Compile builds the fixture in this process and with --debug, the way tests/DebugMap.Test
		does: the line table is filled while the backend still holds the module, and nowhere else. *)
	PROCEDURE Compile (CONST name, source: ARRAY OF CHAR): BOOLEAN;
	VAR optionReader, reader: Streams.StringReader; options: Compiler.CompilerOptions;
		diagnostics: Diagnostics.DiagnosticsList; importCache: SyntaxTree.ModuleScope;
		buffer: Streams.Buffer; log: Streams.Writer;
	BEGIN
		DebugMap.Forget;
		Streams.OpenStringReader(optionReader, "--debug");
		NEW(diagnostics); NEW(buffer, 1024); log := buffer.GetWriter();
		IF ~Compiler.GetOptions(optionReader, log, diagnostics, options) THEN RETURN FALSE END;
		NEW(reader, LEN(source)); reader.Set(source);
		importCache := NIL;
		RETURN Compiler.Modules(name, reader, 0, diagnostics, log, options, importCache)
	END Compile;

	(**	The launcher a breakpoint case gives the adapter: it does what `ob dap` does, minus the
		search paths -- compile with --debug, load the module, say so, and only then start the
		program. The two activations are the whole point: a breakpoint can be written in between. *)
	PROCEDURE Program* (CONST program, procedure: ARRAY OF CHAR; out: Streams.Writer;
			ready: DAP.Ready; VAR message: ARRAY OF CHAR): BOOLEAN;
	VAR source: Text; command: Text; context: Commands.Context; empty: Streams.StringReader;
		result: INTEGER;
	BEGIN
		Build(program, source);
		IF ~Compile(program, source) THEN COPY("the fixture did not compile", message); RETURN FALSE END;
		NEW(empty, 1); empty.Set("");
		NEW(context, NIL, empty, out, out, NIL);
		COPY(program, command); Strings.AppendChar(command, ".");
		Commands.Activate(command, context, {Commands.Wait}, result, message);
		IF result # Commands.Ok THEN RETURN FALSE END;
		IF ready # NIL THEN ready END;
		Strings.Append(command, "Do");
		Commands.Activate(command, context, {Commands.Wait}, result, message);
		RETURN result = Commands.Ok
	END Program;

	(** Run one conversation to its end and collect what came back. *)
	PROCEDURE Converse* (wire: Wire; launcher: DAP.Launcher);
	VAR reader: Streams.Reader; writer: Streams.Writer; context: Commands.Context;
	BEGIN
		NEW(reader, wire.Receive, 1024);
		NEW(writer, wire.Send, 1024);
		NEW(context, reader, NIL, writer, writer, NIL);
		DAP.Serve(context, launcher);
		wire.Collect
	END Converse;

	(**	Wait for an event the program's own activity writes after the conversation is over --
		bounded, so a defect is a failing assertion and not a hanging suite. *)
	PROCEDURE Settle* (wire: Wire; CONST event: ARRAY OF CHAR);
	VAR spins: SIGNED32;
	BEGIN
		spins := 0;
		WHILE (spins < 100000) & ~Contains(wire.transcript, event) DO Objects.Yield; INC(spins) END;
		wire.Collect
	END Settle;

	END DAPTestShared.

positive: a program that traps stops the session on the frame that trapped

	MODULE Test;
	IMPORT T := DAPTestShared, JSON, Strings;
	VAR wire: T.Wire; head, tail: T.Text; body, frame, answer: JSON.Object; frames: JSON.Array;
		text: Strings.String; line: SIGNED32;
	BEGIN
		head := "";
		T.Request(head, 1, "initialize", '{"adapterID":"ob"}');
		T.Request(head, 2, "launch", '{"program":"Fixture.Mod","procedure":"Do"}');
		tail := "";
		T.Request(tail, 3, "threads", "{}");
		T.Request(tail, 4, "stackTrace", '{"threadId":1}');
		T.Request(tail, 5, "disconnect", "{}");
		NEW(wire, head, tail, "");
		T.Converse(wire, T.Crash);

		ASSERT(wire.Seen("initialized"), 1);
		body := wire.Event("stopped");
		ASSERT(body # NIL, 2);                                    (* the trap never reached the editor *)
		ASSERT(JSON.GetString(body, "reason", text) & (text^ = "exception"), 3);
		ASSERT(JSON.GetString(body, "description", text), 4);
		ASSERT(T.Contains(text^, "ASSERT failed"), 5);            (* the trap Boom raises, in words *)

		answer := wire.Answer(4);
		ASSERT(answer # NIL, 6);
		frames := JSON.GetArray(JSON.AsObject(answer.Get("body")), "stackFrames");
		ASSERT(frames # NIL, 7);
		ASSERT(frames.length > 1, 8);                             (* Boom, and whoever called it *)
		frame := JSON.AsObject(frames.At(0));
		ASSERT(JSON.GetString(frame, "name", text), 9);
		ASSERT(T.Contains(text^, "Boom"), 10);                    (* the innermost frame is the one that trapped *)
		ASSERT(JSON.GetInteger(frame, "line", line), 11)          (* 0 here: the case was not compiled with --debug *)
	END Test.

positive: the variables of a frame are read off the stack that is being held

	MODULE Test;
	IMPORT T := DAPTestShared, JSON, Strings;
	VAR wire: T.Wire; head, tail: T.Text; body, answer: JSON.Object; variables, scopes: JSON.Array;
		text: Strings.String; reference, i: SIGNED32; seenSteps, seenHalf: BOOLEAN;
	BEGIN
		head := "";
		T.Request(head, 1, "initialize", '{"adapterID":"ob"}');
		T.Request(head, 2, "launch", '{"program":"Fixture.Mod"}');
		tail := "";
		T.Request(tail, 3, "scopes", '{"frameId":0}');
		T.Request(tail, 4, "variables", '{"variablesReference":1000}');
		T.Request(tail, 5, "evaluate", '{"frameId":0,"expression":"steps"}');
		T.Request(tail, 6, "disconnect", "{}");
		NEW(wire, head, tail, "");
		T.Converse(wire, T.Crash);

		answer := wire.Answer(3);
		ASSERT(answer # NIL, 0);
		scopes := JSON.GetArray(JSON.AsObject(answer.Get("body")), "scopes");
		ASSERT((scopes # NIL) & (scopes.length = 1), 1);
		ASSERT(JSON.GetInteger(JSON.AsObject(scopes.At(0)), "variablesReference", reference), 2);
		ASSERT(reference = 1000, 3);                              (* frame 0, which the tail asked for *)

		answer := wire.Answer(4);
		ASSERT(answer # NIL, 4);
		variables := JSON.GetArray(JSON.AsObject(answer.Get("body")), "variables");
		ASSERT(variables # NIL, 4);
		seenSteps := FALSE; seenHalf := FALSE;
		FOR i := 0 TO SIGNED32(variables.length) - 1 DO
			IF JSON.GetString(JSON.AsObject(variables.At(i)), "name", text) THEN
				IF text^ = "steps" THEN seenSteps := TRUE END;    (* the parameter *)
				IF text^ = "half" THEN seenHalf := TRUE END       (* and the local *)
			END
		END;
		ASSERT(seenSteps, 5);
		ASSERT(seenHalf, 6);

		answer := wire.Answer(5);
		ASSERT(answer # NIL, 7);
		body := JSON.AsObject(answer.Get("body"));
		ASSERT(JSON.GetString(body, "result", text), 7);
		ASSERT(T.Contains(text^, "84"), 8)                        (* Boom was called with 84 *)
	END Test.

positive: what the program writes is an output event, never the protocol stream

	MODULE Test;
	IMPORT T := DAPTestShared, JSON, Strings;
	VAR wire: T.Wire; head, tail: T.Text; body: JSON.Object; text: Strings.String;
	BEGIN
		head := "";
		T.Request(head, 1, "initialize", '{"adapterID":"ob"}');
		T.Request(head, 2, "launch", '{"program":"Loud.Mod"}');
		tail := "";
		T.Request(tail, 3, "continue", '{"threadId":1}');
		T.Request(tail, 4, "disconnect", "{}");
		NEW(wire, head, tail, "");
		T.Converse(wire, T.Crash);

		body := wire.Event("output");
		ASSERT(body # NIL, 1);
		ASSERT(JSON.GetString(body, "output", text), 2);
		ASSERT(T.Contains(text^, "Loud.Mod"), 3);                 (* what the program printed *)
		ASSERT(JSON.GetString(body, "category", text) & (text^ = "stdout"), 4);

		(* continue lets the held program die, and its end is an event of its own *)
		T.Settle(wire, '"event":"terminated"');
		ASSERT(wire.Seen("terminated"), 5);
		ASSERT(wire.Seen("exited"), 6)
	END Test.

positive: a launch without a program is refused, and an unknown request is still answered

	MODULE Test;
	IMPORT T := DAPTestShared, JSON, Strings;
	VAR wire: T.Wire; head: T.Text; answer: JSON.Object; text: Strings.String; ok: BOOLEAN;
	BEGIN
		head := "";
		T.Request(head, 1, "initialize", '{"adapterID":"ob"}');
		T.Request(head, 2, "launch", "{}");
		T.Request(head, 3, "modules", "{}");
		T.Request(head, 4, "disconnect", "{}");
		NEW(wire, head, "", "");
		T.Converse(wire, T.Quiet);      (* nothing is launched, so nothing traps and no gate is needed *)

		answer := wire.Answer(2);
		ASSERT(answer # NIL, 1);
		ASSERT(JSON.GetString(answer, "message", text), 2);
		ASSERT(T.Contains(text^, "program"), 3);

		answer := wire.Answer(3);
		ASSERT(answer # NIL, 4);        (* a request we do not know is answered, so no client hangs *)
		ASSERT(JSON.GetString(answer, "command", text) & (text^ = "modules"), 5);

		answer := wire.Answer(1);
		ASSERT(answer # NIL, 6);
		ok := JSON.GetString(answer, "type", text) & (text^ = "response");
		ASSERT(ok, 7)
	END Test.

positive: a breakpoint stops the program on the line the client asked for, and continuing runs it out

	MODULE Test;
	IMPORT T := DAPTestShared, JSON, Strings;
	VAR wire: T.Wire; head, tail, lines: T.Text; body, frame, answer: JSON.Object;
		frames, variables: JSON.Array; text: Strings.String; line, i: SIGNED32;
		seenSum, seenI: BOOLEAN;
	BEGIN
		T.Build("DAPBreak", lines);                        (* only for the line numbers *)
		head := "";
		T.Request(head, 1, "initialize", '{"adapterID":"ob"}');
		lines := '{"source":{"path":"DAPBreak"},"breakpoints":[{"line":';
		Strings.AppendInt(lines, T.sumLine); Strings.Append(lines, "}]}");
		T.Request(head, 2, "setBreakpoints", lines);
		T.Request(head, 3, "launch", '{"program":"DAPBreak","procedure":"Do"}');
		tail := "";
		T.Request(tail, 4, "stackTrace", '{"threadId":1}');
		T.Request(tail, 5, "variables", '{"variablesReference":1000}');
		T.Request(tail, 6, "continue", '{"threadId":1}');
		T.Request(tail, 7, "disconnect", "{}");
		NEW(wire, head, tail, "");
		T.Converse(wire, T.Program);

		body := wire.Event("stopped");
		ASSERT(body # NIL, 1);                             (* the breakpoint never fired *)
		ASSERT(JSON.GetString(body, "reason", text) & (text^ = "breakpoint"), 2);

		answer := wire.Answer(4);
		ASSERT(answer # NIL, 3);
		frames := JSON.GetArray(JSON.AsObject(answer.Get("body")), "stackFrames");
		ASSERT((frames # NIL) & (frames.length > 0), 4);
		frame := JSON.AsObject(frames.At(0));
		ASSERT(JSON.GetString(frame, "name", text) & T.Contains(text^, "Count"), 5);
		ASSERT(JSON.GetInteger(frame, "line", line), 6);
		ASSERT(line = T.sumLine, 7);                       (* the line the client asked for, verbatim *)

		answer := wire.Answer(5);
		ASSERT(answer # NIL, 8);
		variables := JSON.GetArray(JSON.AsObject(answer.Get("body")), "variables");
		ASSERT(variables # NIL, 8);
		seenSum := FALSE; seenI := FALSE;
		FOR i := 0 TO SIGNED32(variables.length) - 1 DO
			IF JSON.GetString(JSON.AsObject(variables.At(i)), "name", text) THEN
				IF text^ = "sum" THEN seenSum := TRUE END;
				IF text^ = "i" THEN seenI := TRUE END
			END
		END;
		ASSERT(seenSum, 9);
		ASSERT(seenI, 10);

		(*	The program has to end up right: 0+1+2+3+4, computed by code we wrote an instruction
			into and took it back out of five times over. *)
		T.Settle(wire, '"event":"terminated"');
		ASSERT(T.Contains(wire.transcript, "sum=10"), 11);
		ASSERT(wire.Seen("terminated"), 12)
	END Test.

positive: a step from a breakpoint stops on the next statement

	MODULE Test;
	IMPORT T := DAPTestShared, JSON, Strings;
	VAR wire: T.Wire; head, tail, rest, lines: T.Text; body, frame, answer: JSON.Object;
		frames: JSON.Array; text: Strings.String; line: SIGNED32;
	BEGIN
		T.Build("DAPStep", lines);
		head := "";
		T.Request(head, 1, "initialize", '{"adapterID":"ob"}');
		lines := '{"source":{"path":"DAPStep"},"breakpoints":[{"line":';
		Strings.AppendInt(lines, T.sumLine); Strings.Append(lines, "}]}");
		T.Request(head, 2, "setBreakpoints", lines);
		T.Request(head, 3, "launch", '{"program":"DAPStep","procedure":"Do"}');
		tail := "";
		T.Request(tail, 4, "next", '{"threadId":1}');       (* released by the first stop *)
		rest := "";
		T.Request(rest, 5, "stackTrace", '{"threadId":1}'); (* released by the second *)
		T.Request(rest, 6, "disconnect", "{}");
		NEW(wire, head, tail, rest);
		T.Converse(wire, T.Program);

		body := wire.Nth("stopped", 0);
		ASSERT(body # NIL, 1);
		ASSERT(JSON.GetString(body, "reason", text) & (text^ = "breakpoint"), 2);
		body := wire.Nth("stopped", 1);
		ASSERT(body # NIL, 3);                             (* the step never landed *)
		ASSERT(JSON.GetString(body, "reason", text) & (text^ = "step"), 4);

		answer := wire.Answer(5);
		ASSERT(answer # NIL, 5);
		frames := JSON.GetArray(JSON.AsObject(answer.Get("body")), "stackFrames");
		ASSERT((frames # NIL) & (frames.length > 0), 6);
		frame := JSON.AsObject(frames.At(0));
		ASSERT(JSON.GetString(frame, "name", text) & T.Contains(text^, "Count"), 7);
		ASSERT(JSON.GetInteger(frame, "line", line), 8);
		ASSERT(line = T.incLine, 9);                       (* one statement on from the breakpoint *)

		T.Settle(wire, '"event":"terminated"');
		ASSERT(T.Contains(wire.transcript, "sum=10"), 10)
	END Test.

positive: the core alone, driven the way PET drives it

	(*	PET speaks no protocol: it makes a DAP.Core, gives it a Stopped of its own, asks for a line,
		lets the launcher load the module, arms, and runs. This is that sequence with nothing of the
		adapter in it -- the callback records where the program stopped instead of moving a caret.
		Waiting is the bounded spin the harness uses elsewhere and not an AWAIT: a case that can
		hang takes the whole run with it. Only Traps.Breakpoint is installed, and it comes off
		before the first ASSERT -- an assertion traps, and a trap with our hook still in it would
		be held by the very debugger under test. *)

	MODULE Test;
	IMPORT T := DAPTestShared, DAP, DebugMap, Objects, Streams, Traps;

	TYPE
		Watch = OBJECT
		VAR
			core-: DAP.Core;
			stops-, line-: SIGNED32;
			why-: ARRAY 32 OF CHAR;
			ended*: BOOLEAN;   (* set by the Runner below, so not read-only *)

			(* The Core's Stopped, on the activity it is about to hold. *)
			PROCEDURE Stopped* (CONST reason, description: ARRAY OF CHAR);
			VAR file: DebugMap.Name; at: SIGNED32; position: SIGNED64;
			BEGIN
				COPY(reason, why);
				IF (core.count > 0) & DebugMap.PositionOf(core.frames[0].pc, file, at, position) THEN
					line := at
				END;
				INC(stops)
			END Stopped;

			(* The Ready the launcher calls: the code is in, so the line can be written into it. *)
			PROCEDURE Ready*;
			BEGIN
				core.Arm
			END Ready;

			PROCEDURE &Init*;
			BEGIN
				stops := 0; line := 0; why := ""; ended := FALSE; NEW(core, SELF.Stopped)
			END Init;
		END Watch;

		(*	The program runs on an activity of its own, the way `ob dap` puts it on a Debuggee: the
			one that stops is held, and the activity below has to stay free to let it go. *)
		Runner = OBJECT
		VAR watch: Watch; out: Streams.Writer; message: ARRAY 128 OF CHAR;

			PROCEDURE &Init* (w: Watch; writer: Streams.Writer);
			BEGIN watch := w; out := writer
			END Init;

		BEGIN {ACTIVE}
			IF ~T.Program("DAPCore", "Do", out, watch.Ready, message) THEN END;
			watch.ended := TRUE
		END Runner;

	VAR
		watch: Watch; runner: Runner; source: T.Text; buffer: Streams.Buffer;
		firstWhy, stepWhy: ARRAY 32 OF CHAR; firstLine, stepLine, stops: SIGNED32;

	(* Bounded, like T.Settle: waits for the stop to be reported, and gives up rather than hang. *)
	PROCEDURE Wait (n: SIGNED32);
	VAR spins: SIGNED32;
	BEGIN
		spins := 0;
		WHILE (spins < 100000) & (watch.stops < n) DO Objects.Yield; INC(spins) END
	END Wait;

	PROCEDURE WaitEnd;
	VAR spins: SIGNED32;
	BEGIN
		spins := 0;
		WHILE (spins < 100000) & ~watch.ended DO Objects.Yield; INC(spins) END
	END WaitEnd;

	BEGIN
		T.Build("DAPCore", source);                        (* only for the line numbers *)
		NEW(watch);
		Traps.Breakpoint := watch.core.Break;
		watch.core.Want("DAPCore", T.sumLine);             (* by source name, as an editor asks *)

		NEW(buffer, 4096);
		NEW(runner, watch, buffer.GetWriter());

		Wait(1);
		COPY(watch.why, firstWhy); firstLine := watch.line;
		watch.core.Resume(TRUE, FALSE);                    (* F10 *)

		Wait(2);
		COPY(watch.why, stepWhy); stepLine := watch.line;

		(*	SHIFT-F5: the instructions come out of the code and the held activity is let go. The
			loop runs its remaining turns without stopping, which is the proof they came out. *)
		watch.core.Detach;
		watch.core.Release;
		WaitEnd;
		stops := watch.stops;
		Traps.Breakpoint := NIL;

		ASSERT(firstWhy = "breakpoint", 1);
		ASSERT(firstLine = T.sumLine, 2);                  (* the line asked for, and no other *)
		ASSERT(stepWhy = "step", 3);
		ASSERT(stepLine = T.incLine, 4);                   (* one statement on *)
		ASSERT(watch.ended, 5);                            (* the program ran out once let go *)
		ASSERT(stops = 2, 6)
	END Test.
