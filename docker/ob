#!/usr/bin/env bash
#
# ob — a Go-style CLI over the A2 (Active Oberon) toolchain.
#
# Hides the .cfg / System.DoFile / search-path mechanics of the bare `oberon`
# binary behind these verbs:
#
#   ob build   <File.Mod> [-o name] [-t linux64|win64] [Proc]
#                                      link a standalone native executable (runtime
#                                      baked in) that auto-runs Module.Proc (default
#                                      Do). linux64 -> ELF runs as `./name`; win64
#                                      -> a Windows PE64 .exe
#   ob compile <File.Mod> [-o <dir>]   compile one module to a .GofUu object file
#   ob run     <File.Mod> [Proc]       compile then execute a command (default: Do)
#   ob get <pkg>[@ver] ...             fetch package(s) into .a2pkg/, pin in
#                                      a2pkg.lock, add to a2pkg.json, resolve deps.
#                                      <pkg> = git repo (github.com/user/repo) OR a
#                                      registry name (community/matrix) resolved via
#                                      $A2_REGISTRY (git URL or path to the registry).
#   ob lint                            check every import points downward (tier rule)
#   ob doc [File.Mod] [-o dir]         generate HTML API docs (index + per-module)
#   ob lsp [--live]                    run the Active Oberon language server (LSP
#                                      over stdio: diagnostics on open+save; --live
#                                      also re-checks on every change)
#   ob repl                            drop into the interactive A2 shell
#   ob version                         print the SDK version banner
#
# The A2 compiler resolves imported modules from its *current working directory*,
# not from a configurable search path. So each invocation runs inside a private
# scratch dir that is pre-populated with symlinks to the precompiled standard
# library (SDK/lib/*.SymUu + *.GofUu). This keeps the shared SDK read-only and
# lets many builds run concurrently without clobbering each other.
set -euo pipefail

SDK="${A2SDK:-/opt/a2sdk}"
OBERON="$SDK/oberon"
LIB="$SDK/lib"                 # Linux64 stdlib (.GofUu/.SymUu) + compiler runtime
LIBWIN="$SDK/lib-win64"        # Win64 stdlib (.GofWw/.SymWw), if present
LIBSYM="$SDK/lib-sym"          # ALL Linux64 stdlib .SymUu (for LSP import resolution)
PLATFORM="${A2_PLATFORM:-Unix64}"            # compiler backend (Linux)
LINK_PLATFORM="${A2_LINK_PLATFORM:-Linux64}" # linker target (ELF)
BOOT_LIST="${A2_BOOT_LIST:-$SDK/boot-modules.txt}"
BOOT_LIST_WIN="$SDK/boot-modules-win64.txt"
OBJ_EXT="GofUu"
SYM_EXT=".SymUu"

PKGDIR="${A2_PACKAGES:-$SDK/packages}"   # shipped std package manifests (std/*/a2pkg.json)
VENDOR=".a2pkg"                          # per-project package cache (under /work)
PROJ_MANIFEST="a2pkg.json"               # project manifest (in /work)
PROJ_LOCK="a2pkg.lock"                   # pinned versions (in /work)

die() { echo "ob: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

[ -x "$OBERON" ] || die "runtime not found at $OBERON (set A2SDK to the SDK root)"
[ -d "$LIB" ]    || die "standard library not found at $LIB"

# Parse the module name from a `MODULE <Name>;` header, falling back to the
# file's basename. A2 requires the object-file name to match the module name.
module_name() {
  local f="$1" name
  name="$(grep -aoE '^[[:space:]]*MODULE[[:space:]]+[A-Za-z_][A-Za-z0-9_]*' "$f" \
          | head -1 | awk '{print $2}')"
  [ -n "$name" ] || name="$(basename "$f" .Mod)"
  printf '%s' "$name"
}

# Build an isolated work dir seeded with the stdlib symbol + object files for the
# requested target. For win64 we still need the Linux .GofUu objects — the
# compiler itself runs on Linux and loads its backend modules dynamically — plus
# the Win64 .SymWw (target symbols) and .GofWw (link objects).
make_workdir() {
  local target="${1:-linux64}" w
  w="$(mktemp -d "${TMPDIR:-/tmp}/ob.XXXXXX")"
  case "$target" in
    win64)
      [ -d "$LIBWIN" ] || die "win64 target unavailable: $LIBWIN not in this image"
      ln -s "$LIB"/*.GofUu    "$w"/ 2>/dev/null || true   # Linux compiler runtime
      ln -s "$LIBWIN"/*.SymWw "$w"/ 2>/dev/null || true   # Win64 target symbols
      ln -s "$LIBWIN"/*.GofWw "$w"/ 2>/dev/null || true   # Win64 link objects
      ;;
    *)
      ln -s "$LIB"/*"$SYM_EXT"  "$w"/ 2>/dev/null || true
      ln -s "$LIB"/*."$OBJ_EXT" "$w"/ 2>/dev/null || true
      ;;
  esac
  populate_packages "$w"
  printf '%s' "$w"
}

# Symlink installed external packages' sources into the scratch dir, tier by tier
# (lower tiers first). A name already provided by a lower tier is NOT overridden by
# a higher one — a genuine clash is a hard error naming both packages. This is how a
# dependency added by `ob get` becomes resolvable to the compiler (which only looks in
# the cwd) without touching the sealed read-only SDK.
populate_packages() {
  local w="$1" pkgroot="/work/$VENDOR" mf tier name f base owner
  [ -d "$pkgroot" ] || return 0
  declare -A OWNER=()
  # sort package manifests by tier so lower tiers populate first
  while IFS= read -r mf; do
    [ -f "$mf" ] || continue
    name="$(_json "$mf" '.name')"
    while IFS= read -r f; do
      [ -f "$f" ] || continue
      base="$(basename "$f")"
      owner="${OWNER[$base]:-}"
      if [ -n "$owner" ]; then
        die "module clash: $base provided by both $owner and $name (flat A2 namespace — rename or use a Fox context)"
      fi
      OWNER[$base]="$name"
      ln -sf "$f" "$w/$base"
    done < <(find "$(dirname "$mf")" -maxdepth 1 -name '*.Mod')
  done < <(_pkg_manifests_by_tier "$pkgroot")
}

# Compile the installed packages' sources (symlinked by the populator) into the
# scratch dir so their .SymUu/.GofUu exist before the user's module is compiled.
# The plain compiler needs an import's symbol file; only the LSP resolves source
# on demand — so this runs for compile/run/build, NOT for lsp.
build_packages() {
  local w="$1"
  # Compile the populated package sources SINGLE-FILE to a fixpoint. A single
  # multi-file `Compiler.Compile A B C` does NOT topologically reorder — a module
  # listed before its in-batch dependency fails — so we iterate: each round compile
  # every not-yet-compiled module; a module whose imports (stdlib + already-built
  # siblings) now resolve produces its .SymUu, unlocking dependents next round.
  # Repeat until a round builds nothing new. Modules that never compile just stay
  # unresolved and the user-module compile reports the missing import clearly.
  ( cd "$w" && export PWD="$w"
    local mods=() m sym changed
    for m in *.Mod; do [ -e "$m" ] && mods+=("$m"); done
    [ ${#mods[@]} -gt 0 ] || exit 0
    changed=1
    while [ "$changed" = 1 ]; do
      changed=0
      for m in "${mods[@]}"; do
        # the .SymUu is named after the MODULE, not the file — a platform-prefixed
        # source like Unix.V4L2.Mod compiles to V4L2.SymUu, so derive from the header
        sym="$(module_name "$m")$SYM_EXT"
        [ -f "$sym" ] && continue
        if "$OBERON" Compiler.Compile "-p=$PLATFORM" \
             --objectFileExtension="$OBJ_EXT" --symbolFileExtension="$SYM_EXT" \
             "./$m" >/dev/null 2>&1 && [ -f "$sym" ]; then
          changed=1
        fi
      done
    done
  ) || true
}

# List package manifests under a root, ordered by ascending tier (0 first).
_pkg_manifests_by_tier() {
  local root="$1" mf t
  for mf in "$root"/*/"$PROJ_MANIFEST" "$root"/*/*/"$PROJ_MANIFEST" "$root"/*/*/*/"$PROJ_MANIFEST"; do
    [ -f "$mf" ] || continue
    t="$(_json "$mf" '.tier // 9')"
    printf '%s\t%s\n' "$t" "$mf"
  done | sort -n | cut -f2-
}

# Read a jq path from a JSON file; fall back to a tiny grep if jq is absent.
_json() {
  local file="$1" path="$2"
  if have jq; then jq -r "$path // empty" "$file" 2>/dev/null; return; fi
  # minimal fallback for the two scalars we need (.name, .tier)
  case "$path" in
    *name*) grep -oE '"name"[[:space:]]*:[[:space:]]*"[^"]*"' "$file" | head -1 | sed -E 's/.*"([^"]*)"$/\1/' ;;
    *tier*) grep -oE '"tier"[[:space:]]*:[[:space:]]*[0-9]+' "$file" | head -1 | grep -oE '[0-9]+' ;;
  esac
}

cmd_compile() {
  local src="" outdir="."
  while [ $# -gt 0 ]; do
    case "$1" in
      -o|--output) outdir="$2"; shift 2 ;;
      *)           src="$1";    shift   ;;
    esac
  done
  [ -n "$src" ] || die "usage: ob compile <File.Mod> [-o <dir>]"
  [ -f "$src" ] || die "no such file: $src"
  src="$(realpath "$src")"
  mkdir -p "$outdir"; outdir="$(realpath "$outdir")"

  local mod w; mod="$(module_name "$src")"
  w="$(make_workdir)"
  trap 'rm -rf "$w"' RETURN
  build_packages "$w"
  cp "$src" "$w/$mod.Mod"

  ( cd "$w" && export PWD="$w"
    "$OBERON" Compiler.Compile "-p=$PLATFORM" \
      --objectFileExtension="$OBJ_EXT" --symbolFileExtension="$SYM_EXT" \
      "./$mod.Mod" )

  cp "$w/$mod.$OBJ_EXT" "$outdir/" 2>/dev/null \
    || die "compile produced no $mod.$OBJ_EXT"
  [ -f "$w/$mod$SYM_EXT" ] && cp "$w/$mod$SYM_EXT" "$outdir/" || true
  echo "ob: wrote $outdir/$mod.$OBJ_EXT"
}

cmd_build() {
  local src="" outname="" proc="Do" target="linux64"
  while [ $# -gt 0 ]; do
    case "$1" in
      -o|--output)  outname="$2"; shift 2 ;;
      -t|--target)  target="$2";  shift 2 ;;
      -*)           die "unknown option: $1" ;;
      *) if [ -z "$src" ]; then src="$1"; else proc="$1"; fi; shift ;;
    esac
  done
  [ -n "$src" ] || die "usage: ob build <File.Mod> [-o <name>] [-t linux64|win64] [Proc]"
  [ -f "$src" ] || die "no such file: $src"
  src="$(realpath "$src")"

  # per-target toolchain settings
  local c_ext s_ext bootfile linkopts suffix
  case "$target" in
    linux64)
      c_ext="GofUu"; s_ext=".SymUu"; bootfile="$BOOT_LIST"; suffix=""
      linkopts="-p=$LINK_PLATFORM --extension=GofUu" ;;
    win64)
      c_ext="GofWw"; s_ext=".SymWw"; bootfile="$BOOT_LIST_WIN"; suffix=".exe"
      linkopts="--fileFormat=PE64CUI --extension=GofWw --displacement=401000H" ;;
    *) die "unknown target: $target (use linux64 or win64)" ;;
  esac
  [ -f "$bootfile" ] || die "boot module list not found: $bootfile"
  local c_plat; [ "$target" = win64 ] && c_plat="Win64" || c_plat="$PLATFORM"

  local mod w boot dest; mod="$(module_name "$src")"
  [ -n "$outname" ] || outname="$mod$suffix"
  case "$outname" in /*) dest="$outname" ;; *) dest="$(pwd)/$outname" ;; esac
  mkdir -p "$(dirname "$dest")"

  local fn; fn="$(basename "$dest")"
  w="$(make_workdir "$target")"
  trap 'rm -rf "$w"' RETURN
  build_packages "$w"
  cp "$src" "$w/$mod.Mod"

  # A generated boot driver replaces the interactive shell: its module body runs
  # at startup, calls the chosen command, and maps success/failure to exit 0/1
  # (A2 quirk: Reboot -> exit(0), PowerDown -> exit(1)). Importing the user
  # module forces the linker to include it.
  cat > "$w/ObEntry.Mod" <<EOF
MODULE ObEntry;
IMPORT Commands, Modules, Trace, $mod;
VAR res: INTEGER; msg: ARRAY 256 OF CHAR;
BEGIN
	Commands.Call("$mod.$proc", {Commands.Wait}, res, msg);
	IF res = 0 THEN Modules.Shutdown(Modules.Reboot)
	ELSE Trace.String(msg); Trace.Ln; Modules.Shutdown(Modules.PowerDown) END
END ObEntry.
EOF

  # Boot set minus the interactive shell (StdIOShell/Shell) — our ObEntry drives
  # startup instead. The linker auto-resolves the rest of the import closure.
  boot="$(grep -vE '^(StdIOShell|Shell)$' "$bootfile" | tr '\n' ' ')"

  ( cd "$w" && export PWD="$w"
    "$OBERON" Compiler.Compile "-p=$c_plat" \
      --objectFileExtension="$c_ext" --symbolFileExtension="$s_ext" \
      "./$mod.Mod" "./ObEntry.Mod" >/dev/null
    "$OBERON" do "
      Linker.Link --path=./ $linkopts --fileName=$fn
      $boot $mod ObEntry
      ~
    " | tr -d '\r' | grep -vE '^GC mode|^WORK:' || true
    [ -f "$fn" ] || die "link failed (no output binary produced)"
    cp "$fn" "$dest" )

  chmod +x "$dest"
  echo "ob: wrote $dest  (target: $target, baked entry: $mod.$proc)"
  if [ "$target" = win64 ]; then
    echo "    a Windows PE64 console .exe — run it on Windows: $fn"
  else
    echo "    run it (no A2 needed):  $dest"
  fi
}

cmd_run() {
  local src="${1:-}"; shift || true
  local proc="${1:-Do}"
  [ -n "$src" ] || die "usage: ob run <File.Mod> [Proc]"
  [ -f "$src" ] || die "no such file: $src"
  src="$(realpath "$src")"

  local mod w; mod="$(module_name "$src")"
  w="$(make_workdir)"
  trap 'rm -rf "$w"' RETURN
  build_packages "$w"
  cp "$src" "$w/$mod.Mod"

  ( cd "$w" && export PWD="$w"
    "$OBERON" Compiler.Compile "-p=$PLATFORM" \
      --objectFileExtension="$OBJ_EXT" --symbolFileExtension="$SYM_EXT" \
      "./$mod.Mod" >/dev/null
    exec "$OBERON" "$mod.$proc" )
}

cmd_repl() { exec "$OBERON" do "System.DoFile $SDK/oberon.cfg ~"; }

# Language server: speaks LSP over stdin/stdout. Runs in a scratch dir seeded with
# the stdlib symbols so the diagnostics compiler can resolve imports. Blocks until
# the editor closes the connection (stdin EOF), then cleans up.
cmd_lsp() {
  local w entry="LSP.Run"
  [ "${1:-}" = "--live" ] && entry="LSP.RunLive"
  w="$(make_workdir)"
  trap 'rm -rf "$w"' RETURN
  # full stdlib symbols so the checker resolves any in-tree import (GUI etc.)
  [ -d "$LIBSYM" ] && ln -sf "$LIBSYM"/*.SymUu "$w"/ 2>/dev/null || true
  # the project's own prebuilt symbol files (its build output, mounted at /psym) win
  # over the bundled stdlib: imports then resolve from real build artifacts instead of
  # fragile on-demand compilation (and module-in-prefixed-file cases resolve too).
  [ -d /psym ] && ln -sf /psym/*.SymUu "$w"/ 2>/dev/null || true
  # installed external packages (ob get) are already symlinked by make_workdir's
  # populator; the LSP resolves their source on demand (no precompile needed).
  # project sources mounted at /work become resolvable via on-demand compilation
  [ -d /work ] && ln -sf /work/*.Mod "$w"/ 2>/dev/null || true
  ( cd "$w" && export PWD="$w" && exec "$OBERON" "$entry" )
}

# ob get <host/user/repo>[@version] ... — fetch package(s) into /work/.a2pkg, pin them
# in a2pkg.lock, add them to a2pkg.json, and transitively fetch their external deps.
# std/* requirements are satisfied by the SDK and are never fetched.
cmd_get() {
  have git || die "ob get needs git in the image"
  have jq  || die "ob get needs jq in the image"
  [ -d /work ] || die "mount your project at /work"
  [ $# -ge 1 ] || die "usage: ob get <host/user/repo>[@version] ..."
  local spec; for spec in "$@"; do _get_one "$spec"; done
  echo "ob: updated $PROJ_MANIFEST + $PROJ_LOCK ; deps vendored in $VENDOR/"
}

# Dispatch a dependency spec. A first path segment that looks like a host
# (contains a dot) is a git repo: `github.com/user/repo`. A bare name is a
# registry package resolved via A2_REGISTRY + index.json: `community/matrix`.
_get_one() {
  local spec="$1" repo ver first
  case "$spec" in *@*) ver="${spec##*@}"; repo="${spec%@*}" ;; *) ver=""; repo="$spec" ;; esac
  first="${repo%%/*}"
  case "$first" in
    *.*) _get_git "$repo" "$ver" ;;
    *)   _get_registry "$repo" "$ver" ;;
  esac
}

_get_git() {
  local repo="$1" ver="$2" cache sha name dep
  cache="/work/$VENDOR/$repo"
  # Shallow, VCS-free vendoring: clone only the requested tag/branch at depth 1,
  # capture the exact commit for the lock, then drop .git so the cache holds just
  # the package source. There is no incremental fetch — a re-get re-clones fresh.
  rm -rf "$cache"; mkdir -p "$(dirname "$cache")"
  if [ -n "$ver" ]; then
    git -c advice.detachedHead=false clone -q --depth 1 --branch "$ver" \
      "https://$repo.git" "$cache" \
      || die "clone failed: $repo @ $ver (version must be a tag or branch)"
  else
    git clone -q --depth 1 "https://$repo.git" "$cache" || die "clone failed: $repo"
  fi
  [ -f "$cache/$PROJ_MANIFEST" ] || die "$repo is not an A2 package (no $PROJ_MANIFEST)"
  sha="$(git -C "$cache" rev-parse HEAD)"
  [ -n "$ver" ] || ver="$sha"
  rm -rf "$cache/.git"                       # vendored source only — no VCS metadata
  name="$(jq -r '.name' "$cache/$PROJ_MANIFEST")"
  _record_dep "$repo" "$ver" "$sha"
  echo "ob: got $name  ($repo @ $ver, ${sha:0:12})"
  _get_transitive "$cache"
}

# Locate the registry once (a git URL cloned shallow, or a local dir path used
# in place) and cache the checkout for the rest of this ob invocation.
_ensure_registry() {
  [ -n "${A2_REGISTRY:-}" ] || die "ob get by name needs A2_REGISTRY (git URL or path to the registry)"
  if [ -z "${_REGDIR:-}" ]; then
    if [ -d "$A2_REGISTRY" ]; then _REGDIR="$A2_REGISTRY"
    else _REGDIR="/work/$VENDOR/.registry"; rm -rf "$_REGDIR"
         git clone -q --depth 1 "$A2_REGISTRY" "$_REGDIR" || die "registry clone failed: $A2_REGISTRY"; fi
    [ -f "$_REGDIR/index.json" ] || die "registry has no index.json: $A2_REGISTRY"
  fi
  printf '%s' "$_REGDIR"
}

_get_registry() {
  local name="$1" ver="$2" reg path status dest v dep
  reg="$(_ensure_registry)"
  path="$(jq -r --arg n "$name" '.packages[$n].path // empty' "$reg/index.json")"
  status="$(jq -r --arg n "$name" '.packages[$n].status // "unknown"' "$reg/index.json")"
  [ -n "$path" ] || die "package not in registry: $name (registry: $A2_REGISTRY)"
  [ -d "$reg/$path" ] || die "registry package $name is '$status' — no installable source at $path yet"
  dest="/work/$VENDOR/$name"
  rm -rf "$dest"; mkdir -p "$(dirname "$dest")"
  cp -r "$reg/$path/." "$dest/"
  v="$(jq -r '.version // "0.0.0"' "$dest/$PROJ_MANIFEST" 2>/dev/null || echo 0.0.0)"
  [ -n "$ver" ] && v="$ver"
  _record_dep "$name" "$v" "registry"
  echo "ob: got $name  (registry @ $v)"
  _get_transitive "$dest"
}

# Recurse into a just-installed package's external (non-std) requirements.
_get_transitive() {
  local pkgdir="$1" dep
  [ -f "$pkgdir/$PROJ_MANIFEST" ] || return 0
  while IFS= read -r dep; do
    [ -n "$dep" ] || continue
    case "$dep" in std/*) continue ;; esac
    [ -d "/work/$VENDOR/$dep" ] && continue
    _get_one "$dep"
  done < <(jq -r '.requires // {} | keys[]' "$pkgdir/$PROJ_MANIFEST" 2>/dev/null)
}

_record_dep() {
  local repo="$1" ver="$2" sha="$3" pm="/work/$PROJ_MANIFEST" lk="/work/$PROJ_LOCK" tmp
  [ -f "$pm" ] || echo '{"name":"app","requires":{}}' > "$pm"
  [ -f "$lk" ] || echo '{}' > "$lk"
  tmp="$(mktemp)"; jq --arg r "$repo" --arg v "$ver" '.requires[$r]=$v' "$pm" > "$tmp" && mv "$tmp" "$pm"
  tmp="$(mktemp)"; jq --arg r "$repo" --arg v "$ver" --arg s "$sha" \
      '.[$r]={version:$v,commit:$s}' "$lk" > "$tmp" && mv "$tmp" "$lk"
}

# ob lint — verify every import points to the same tier or lower. Reads the shipped
# std manifests + installed packages for the module->tier map, then walks the import
# graph of the project's .Mod files. An upward edge (e.g. std/math importing a tier-2
# module) is the layering violation the tier model forbids.
cmd_lint() {
  [ -d /work ] || die "mount your project at /work"
  local mf name tier m f mod mtier iimp itier violations=0
  declare -A TIER PKG
  for mf in "$PKGDIR"/std/*/"$PROJ_MANIFEST" \
            /work/"$VENDOR"/*/"$PROJ_MANIFEST" \
            /work/"$VENDOR"/*/*/"$PROJ_MANIFEST" \
            /work/"$VENDOR"/*/*/*/"$PROJ_MANIFEST"; do
    [ -f "$mf" ] || continue
    name="$(_json "$mf" '.name')"; tier="$(_json "$mf" '.tier')"; [ -n "$tier" ] || tier=9
    while IFS= read -r m; do [ -n "$m" ] && { TIER[$m]="$tier"; PKG[$m]="$name"; }; done < <(_provides "$mf")
  done
  [ "${#TIER[@]}" -gt 0 ] || die "no package manifests found (looked in $PKGDIR and /work/$VENDOR)"
  for f in /work/*.Mod; do
    [ -f "$f" ] || continue
    mod="$(module_name "$f")"; mtier="${TIER[$mod]:-9}"   # project/app code defaults to top
    while IFS= read -r iimp; do
      itier="${TIER[$iimp]:-}"; [ -z "$itier" ] && continue
      if [ "$itier" -gt "$mtier" ]; then
        echo "  UP-EDGE  $mod (tier $mtier, ${PKG[$mod]:-project}) -> $iimp (tier $itier, ${PKG[$iimp]:-?})"
        violations=$((violations+1))
      fi
    done < <(_imports "$f")
  done
  [ "$violations" -eq 0 ] && echo "ob lint: OK — no upward dependencies" \
    || die "$violations upward-dependency violation(s)"
}

_provides() { if have jq; then jq -r '.provides[]?' "$1" 2>/dev/null; fi; }
_imports() {
  awk '/(^|[^A-Za-z])IMPORT/{p=1} p{print} /;/{if(p)exit}' "$1" \
    | sed -E 's/.*IMPORT//; s/;.*//' | tr ',' '\n' \
    | sed -E 's/\(\*[^*]*\*\)//g; s/.*:=//; s/[[:space:]]+IN[[:space:]]+[A-Za-z0-9_]+//; s/[^A-Za-z0-9_]//g' \
    | grep -Ev '^$|^SYSTEM$'
}

# ob doc [File.Mod] [-o outdir] — generate pkg.go.dev-style HTML API docs from
# module doc-comments, via the Fox compiler's Documentation backend. With a file:
# just that module. Without: every *.Mod in /work + an index.html. Installed
# packages are compiled first (fixpoint) so imports resolve for the type-check the
# doc backend runs.
cmd_doc() {
  local src="" outdir="doc"
  while [ $# -gt 0 ]; do
    case "$1" in -o|--output) outdir="$2"; shift 2 ;; *) src="$1"; shift ;; esac
  done
  [ -d /work ] || die "mount your project/package at /work"
  mkdir -p "$outdir"; outdir="$(realpath "$outdir")"
  local w; w="$(make_workdir)"; trap 'rm -rf "$w"' RETURN
  build_packages "$w"                                   # resolve installed-package imports
  ln -sf /work/*.Mod "$w"/ 2>/dev/null || true          # project siblings resolvable
  build_packages "$w"                                   # compile siblings too (fixpoint)
  local list m
  if [ -n "$src" ]; then list="$(basename "$src")"; else
    list="$(cd /work && for f in *.Mod; do [ -e "$f" ] && basename "$f"; done)"
  fi
  local timo="${A2_DOC_TIMEOUT:-30}"   # per-module guard: the Documentation backend
  ( cd "$w" && export PWD="$w"          # hangs on some modules — skip, don't stall the run
    for f in $list; do
      [ -f "$f" ] || continue
      m="$(module_name "$f")"           # name the page after the MODULE, not the file
      if timeout -k 5 "$timo" "$OBERON" Compiler.Compile "-p=$PLATFORM" \
           --symbolFileExtension="$SYM_EXT" --documentation="$m.html" "./$f" \
           >/dev/null 2>&1 && [ -f "$m.html" ]; then
        cp "$m.html" "$outdir/"
      else
        echo "ob: doc skipped $m (timeout ${timo}s or error)" >&2
      fi
    done )
  { echo "<!doctype html><meta charset=utf-8><title>Package docs</title>"
    echo "<h1>API documentation</h1><ul>"
    for h in "$outdir"/*.html; do
      b="$(basename "$h" .html)"; [ "$b" = index ] && continue
      echo "  <li><a href=\"$b.html\">$b</a></li>"
    done
    echo "</ul>"; } > "$outdir/index.html"
  echo "ob: wrote docs to $outdir ($(ls "$outdir"/*.html | grep -vc '/index.html$') modules + index.html)"
}

cmd_version() {
  echo "A2 (Active Oberon) SDK — minia2"
  echo "  runtime : $OBERON"
  echo "  stdlib  : $(ls "$LIB"/*"$SYM_EXT" 2>/dev/null | wc -l) modules (linux64)"
  if [ -d "$LIBWIN" ]; then
    echo "            $(ls "$LIBWIN"/*.SymWw 2>/dev/null | wc -l) modules (win64)"
  fi
  echo "  targets : linux64 (ELF)$([ -d "$LIBWIN" ] && echo ', win64 (PE .exe)')"
}

case "${1:-}" in
  build)   shift; cmd_build "$@" ;;
  compile) shift; cmd_compile "$@" ;;
  run)     shift; cmd_run "$@" ;;
  get)     shift; cmd_get "$@" ;;
  lint)    shift; cmd_lint "$@" ;;
  doc)     shift; cmd_doc "$@" ;;
  repl)    shift; cmd_repl ;;
  lsp)     shift; cmd_lsp "$@" ;;
  version|--version|-v) cmd_version ;;
  ""|help|-h|--help)
    sed -n '3,23p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $1 (try: ob help)" ;;
esac
